{
  // Preview do site na Cloudflare: um Worker que só serve os arquivos do dist/.
  // A Cloudflare recomenda Workers no lugar do Pages para projeto novo.
  // O dist/ é sempre o build de preview (npm run build:preview), com noindex na meta e no _headers.
  // O build de produção sai em dist-producao/ e nunca vem para cá.
  "name": "9vee-preview",
  "compatibility_date": "2026-09-19",
  "assets": {
    "directory": "./dist",
    // Endereço que não existe recebe a página 404 do próprio site.
    "not_found_handling": "404-page"
  }
}
