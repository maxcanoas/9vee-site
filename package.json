{
  "name": "9vee-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:rede": "astro dev --host",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run --project unit && astro build && node scripts/build-indexavel.ts && vitest run --project dist",
    "test:unit": "vitest run --project unit",
    "test:dist": "vitest run --project dist",
    "screenshots": "node scripts/screenshots.ts",
    "e2e": "astro build && playwright test",
    "deploy": "astro build && npx wrangler deploy"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.1",
    "astro": "^7.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.3",
    "esbuild": "^0.28.2",
    "html-validate": "^11.4.0",
    "node-html-parser": "^9.0.4",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  }
}
