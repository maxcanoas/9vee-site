---
import Base from '../layouts/Base.astro';
import HeroPagina from '../components/HeroPagina.astro';
import Cartoes from '../components/Cartoes.astro';
import { dadosDoSite, trilhaDaPagina } from '../lib/site';
import { paginaParcial } from '../lib/paginas';
import { trilhaDeNavegacao } from '../lib/jsonld';

const { data: pagina } = await paginaParcial('quem-somos');
const site = await dadosDoSite();
const base = Astro.site ?? new URL(Astro.url.origin);
const trilha = trilhaDaPagina(site, 'quemSomos', Astro.url.pathname);
const jsonLd = [trilhaDeNavegacao(base, trilha)];
---

<Base pagina="quemSomos" titulo={pagina.seo.titulo} descricao={pagina.seo.descricao} jsonLd={jsonLd}>
  <HeroPagina {...pagina.hero} trilha={trilha} textos={site.cta} etiqueta={site.etiquetaMvp} />
  <Cartoes id="frentes" {...pagina.bloco} textos={site.cta} />
</Base>
