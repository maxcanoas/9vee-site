---
// Página de trabalho da etapa 1: mostra o sistema visual antes da home. Fica fora do menu.
import Base from '../layouts/Base.astro';
import SvgDoKit from '../components/SvgDoKit.astro';
import nove from '../../assets-cliente/Vectors/Stamp.svg?raw';
import { formatarInline } from '../lib/texto';

const cores = [
  { nome: 'Papel', hex: '#F9F9F9', origem: 'oficial', papel: 'Fundo base', medida: 'navy sobre ele: 12,9:1', classe: 'amostra--papel' },
  { nome: 'Navy', hex: '#212D4D', origem: 'oficial', papel: 'Texto e blocos escuros', medida: 'sobre o papel: 12,9:1', classe: 'amostra--navy' },
  { nome: 'Menta', hex: '#16DF97', origem: 'oficial', papel: 'Botões, sempre com texto navy', medida: 'navy sobre ela: 7,8:1', classe: 'amostra--menta' },
  { nome: 'Magenta', hex: '#FE19D6', origem: 'oficial', papel: 'Anel de foco e formas', medida: 'no claro 3,2:1; no navy 4,1:1', classe: 'amostra--magenta' },
  { nome: 'Violeta', hex: '#5C58F4', origem: 'oficial', papel: 'Só formas e gradientes', medida: 'fora do texto de interface', classe: 'amostra--violeta' },
  { nome: 'Navy 2', hex: '#525B75', origem: 'derivada', papel: 'Texto secundário', medida: 'sobre o papel: 6,4:1', classe: 'amostra--navy-2' },
  { nome: 'Névoa', hex: '#EEF0F6', origem: 'derivada', papel: 'Fundo alternado', medida: 'navy sobre ela: 11,9:1', classe: 'amostra--nevoa' },
  { nome: 'Sobre o escuro', hex: '#B8BFD3', origem: 'derivada', papel: 'Texto secundário no navy', medida: 'sobre o navy: 7,4:1', classe: 'amostra--sobre-escuro' },
];

const saudacoes = [
  { texto: 'Olá', lang: 'pt', idioma: 'Português' },
  { texto: 'Hola', lang: 'es', idioma: 'Espanhol' },
  { texto: 'Bonjour', lang: 'fr', idioma: 'Francês' },
  { texto: 'Ciao', lang: 'it', idioma: 'Italiano' },
  { texto: 'Bună', lang: 'ro', idioma: 'Romeno' },
  { texto: 'Hello', lang: 'en', idioma: 'Inglês' },
  { texto: 'Hallo', lang: 'de', idioma: 'Alemão' },
  { texto: 'Hoi', lang: 'nl', idioma: 'Holandês' },
  { texto: 'Hej', lang: 'sv', idioma: 'Sueco' },
  { texto: 'Hei', lang: 'nb', idioma: 'Norueguês' },
  { texto: 'Привет', lang: 'ru', idioma: 'Russo' },
  { texto: 'مرحبا', lang: 'ar', idioma: 'Árabe', dir: 'rtl' },
  { texto: '你好', lang: 'zh-Hans', idioma: 'Mandarim' },
  { texto: 'こんにちは', lang: 'ja', idioma: 'Japonês' },
];

const colaboradores = ['Até 50', '51 a 200', '201 a 1.000', 'Mais de 1.000'];
---

<Base
  pagina="especime"
  titulo="Espécime visual | 9vee"
  descricao="Página de trabalho do MVP da 9vee com as cores, a tipografia e os componentes básicos do novo site, para revisão antes da home. Ela não aparece no menu."
>
  <div class="conteiner especime">
    <div class="especime__topo">
      <p class="especime__etapa">Etapa 1 do MVP, base visual</p>
      <h1>Espécime visual</h1>
      <p class="especime__intro texto-secundario">
        As cores, a tipografia e os componentes que a home e as páginas de serviço vão usar. Esta página é
        de trabalho e fica fora do menu.
      </p>
    </div>

    <section class="especime__secao" aria-labelledby="cores">
      <h2 id="cores">Cores</h2>
      <p class="texto-secundario">As cinco oficiais do kit, cada uma com um papel, e três tons derivados só para texto e fundo.</p>
      <ul class="cores" role="list">
        {
          cores.map((cor) => (
            <li class="cor">
              <span class={`cor__amostra ${cor.classe}`} />
              <span class="cor__nome">
                {cor.nome} <span class="cor__hex">{cor.hex}</span>
              </span>
              <span class="cor__papel">{cor.papel}</span>
              <span class="cor__medida texto-secundario">
                {cor.origem}, {cor.medida}
              </span>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="especime__secao" aria-labelledby="tipo">
      <h2 id="tipo">Tipografia</h2>
      <div class="tipo">
        <p class="tipo__rotulo">Readex Pro 600, títulos</p>
        <p class="tipo__t1">Idiomas, intérpretes e treinamento de NR-1</p>
        <p class="tipo__t2">Intérprete na cabine, público no receptor</p>
        <p class="tipo__t3">Três módulos e um plano de ação no fim</p>
        <p class="tipo__rotulo">Source Sans 3, texto</p>
        <p class="tipo__destaque">Aula particular, em grupo ou para a equipe inteira, online ou na sua cidade.</p>
        <p class="tipo__corpo">
          A interpretação simultânea leva a fala para outra língua quase no mesmo instante. O intérprete trabalha
          na cabine, com fone e microfone, e o público ouve pelo receptor, no idioma que escolher.
        </p>
        <p class="tipo__pequeno texto-secundario">Legenda e texto de apoio: 15 px, com contraste acima de 4,5:1.</p>
      </div>
    </section>

    <section class="especime__secao" aria-labelledby="saudacoes">
      <h2 id="saudacoes">Saudações nos 14 idiomas</h2>
      <p class="texto-secundario">
        Latim e árabe saem na Readex Pro. Russo, mandarim e japonês usam a fonte do aparelho, com o idioma
        marcado para o celular escolher a letra certa.
      </p>
      <ul class="saudacoes" role="list">
        {
          saudacoes.map((s) => (
            <li class="saudacao">
              <span class="saudacao__texto" lang={s.lang} dir={s.dir}>
                {s.texto}
              </span>
              <span class="saudacao__idioma texto-secundario">{s.idioma}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="especime__secao" aria-labelledby="interacao">
      <h2 id="interacao">Botões e escolhas</h2>
      <div class="acoes">
        <button class="botao" type="button">Pedir orçamento</button>
        <button class="botao botao--contorno" type="button">Ver os três módulos</button>
        <a href="/treinamento-nr-1/">Link no meio do texto</a>
      </div>
      <p class="texto-secundario">Navegue com Tab para ver o anel de foco magenta.</p>

      <fieldset class="duas-metades">
        <legend class="duas-metades__legenda">É para:</legend>
        <div class="duas-metades__pilula">
          <label class="duas-metades__metade">
            <input class="visualmente-oculto" type="radio" name="publico-amostra" value="empresa" />
            <span>Para sua empresa</span>
          </label>
          <label class="duas-metades__metade">
            <input class="visualmente-oculto" type="radio" name="publico-amostra" value="voce" />
            <span>Para você</span>
          </label>
        </div>
      </fieldset>

      <fieldset class="opcoes">
        <legend class="opcoes__legenda">Quantos colaboradores a empresa tem?</legend>
        <div class="opcoes__lista">
          {
            colaboradores.map((faixa) => (
              <label class="opcao">
                <input class="visualmente-oculto" type="radio" name="colaboradores-amostra" value={faixa} />
                <span>{faixa}</span>
              </label>
            ))
          }
        </div>
      </fieldset>
    </section>

    <section class="especime__secao" aria-labelledby="formas">
      <h2 id="formas">Formas da marca</h2>
      <p class="texto-secundario">
        Os meios-círculos do padrão do kit. Na home, eles começam separados no topo e se juntam com a rolagem.
      </p>
      <div class="formas" aria-hidden="true">
        <div class="par par--separado">
          <span class="meia meia--esquerda meia--menta"></span>
          <span class="meia meia--direita meia--magenta"></span>
        </div>
        <div class="par par--junto">
          <span class="meia meia--esquerda meia--violeta"></span>
          <span class="meia meia--direita meia--menta"></span>
        </div>
        <div class="arco"></div>
        <div class="nove">
          <SvgDoKit bruto={nove} />
        </div>
      </div>
    </section>

    <section class="especime__secao" aria-labelledby="pendencia">
      <h2 id="pendencia">Pendência</h2>
      <p
        set:html={formatarInline(
          'A 9vee atende há 19 anos [CONFIRMAR COM A DANIELLA: o Quem Somos diz "mais de 20 anos"], em 14 idiomas.',
        )}
      />
    </section>
  </div>

  <section class="escuro bloco-escuro" aria-labelledby="escuro">
    <div class="conteiner bloco-escuro__grade">
      <h2 id="escuro">Um bloco escuro</h2>
      <p class="texto-secundario">
        Os blocos navy marcam os momentos fortes da página: o destaque do NR-1 e o fechamento com o contato.
      </p>
      <button class="botao" type="button">Pedir orçamento</button>
    </div>
  </section>
</Base>

<style>
  .especime {
    display: grid;
    gap: var(--e-8);
    padding-block: var(--e-7) var(--secao);
  }

  .especime__topo {
    display: grid;
    gap: var(--e-4);
  }

  .especime__etapa {
    color: var(--navy-2);
    font-size: var(--t-pequeno);
    font-weight: 700;
  }

  .especime__intro {
    max-inline-size: var(--medida);
    font-size: var(--t-destaque);
  }

  .especime__secao {
    display: grid;
    gap: var(--e-5);
  }

  .especime__secao > p {
    max-inline-size: var(--medida);
  }

  .cores {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(9.5rem, 1fr));
    gap: var(--e-6) var(--e-5);
    padding: 0;
    list-style: none;
  }

  .cor {
    display: grid;
    gap: var(--e-1);
  }

  .cor__amostra {
    display: block;
    block-size: 4rem;
    margin-block-end: var(--e-2);
    border: 1px solid var(--linha);
    border-radius: var(--raio-arco);
  }

  .amostra--papel { background-color: var(--papel); }
  .amostra--navy { background-color: var(--navy); }
  .amostra--menta { background-color: var(--menta); }
  .amostra--magenta { background-color: var(--magenta); }
  .amostra--violeta { background-color: var(--violeta); }
  .amostra--navy-2 { background-color: var(--navy-2); }
  .amostra--nevoa { background-color: var(--nevoa); }
  .amostra--sobre-escuro { background-color: var(--sobre-escuro); }

  .cor__nome {
    font-family: var(--fonte-titulo);
    font-weight: 600;
  }

  .cor__hex {
    color: var(--navy-2);
    font-family: var(--fonte-texto);
    font-weight: 400;
    font-variant-numeric: tabular-nums;
  }

  .cor__medida {
    font-size: var(--t-pequeno);
  }

  .tipo {
    display: grid;
    gap: var(--e-4);
  }

  .tipo__rotulo {
    margin-block-start: var(--e-5);
    color: var(--navy-2);
    font-size: var(--t-pequeno);
    font-weight: 700;
  }

  .tipo__t1,
  .tipo__t2,
  .tipo__t3 {
    font-family: var(--fonte-titulo);
    font-weight: 600;
    text-wrap: balance;
  }

  .tipo__t1 {
    font-size: var(--t-1);
    line-height: var(--altura-titulo);
    letter-spacing: var(--rastreio-titulo);
  }

  .tipo__t2 {
    font-size: var(--t-2);
    line-height: var(--altura-titulo);
    letter-spacing: var(--rastreio-titulo);
  }

  .tipo__t3 {
    font-size: var(--t-3);
    line-height: var(--altura-subtitulo);
  }

  .tipo__destaque {
    max-inline-size: 36ch;
    font-size: var(--t-destaque);
    line-height: 1.4;
  }

  .tipo__corpo {
    max-inline-size: var(--medida);
  }

  .tipo__pequeno {
    font-size: var(--t-pequeno);
  }

  .saudacoes {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(9.5rem, 1fr));
    gap: var(--e-5);
    padding: 0;
    list-style: none;
  }

  .saudacao {
    display: grid;
    gap: var(--e-1);
    padding-block-start: var(--e-3);
    border-block-start: 1px solid var(--linha);
  }

  .saudacao__texto {
    justify-self: start; /* o árabe, em RTL, iria para a direita da célula */
    font-family: var(--fonte-titulo);
    font-size: var(--t-3);
    font-weight: 600;
    line-height: 1.3;
  }

  .saudacao__idioma {
    font-size: var(--t-pequeno);
  }

  .acoes {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--e-4) var(--e-5);
  }

  /* A escolha de público: duas metades de uma pílula. */
  .duas-metades,
  .opcoes {
    min-inline-size: 0;
    padding: 0;
    border: 0;
  }

  .duas-metades__legenda,
  .opcoes__legenda {
    margin-block-end: var(--e-3);
    font-family: var(--fonte-titulo);
    font-weight: 600;
  }

  .duas-metades__pilula {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3px;
    max-inline-size: 30rem;
  }

  .duas-metades__metade,
  .opcao {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-block-size: 3rem;
    padding-inline: var(--e-3);
    border: 1.5px solid var(--navy);
    font-family: var(--fonte-titulo);
    font-weight: 600;
    line-height: 1.2;
    text-align: center;
    cursor: pointer;
    transition-property: background-color, color, border-color;
    transition-duration: var(--dur-rapida);
  }

  .duas-metades__metade:first-child {
    border-radius: var(--raio-pilula) 0 0 var(--raio-pilula);
  }

  .duas-metades__metade:last-child {
    border-radius: 0 var(--raio-pilula) var(--raio-pilula) 0;
  }

  .duas-metades__metade:hover,
  .opcao:hover {
    background-color: var(--nevoa);
  }

  .duas-metades__metade:has(input:checked),
  .opcao:has(input:checked) {
    background-color: var(--navy);
    color: var(--papel);
  }

  .duas-metades__metade:has(input:focus-visible),
  .opcao:has(input:focus-visible) {
    outline: 2px solid var(--magenta);
    outline-offset: 3px;
  }

  .opcoes__lista {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-2);
  }

  .opcao {
    border-color: var(--linha);
    border-radius: var(--raio-pilula);
    font-family: var(--fonte-texto);
    font-weight: 700;
  }

  .formas {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: var(--e-6);
  }

  .par {
    display: flex;
    align-items: center;
    block-size: 6rem;
  }

  .par--separado {
    gap: var(--e-5);
  }

  .meia {
    display: block;
    inline-size: 3rem;
    block-size: 6rem;
  }

  .meia--esquerda {
    border-radius: var(--raio-pilula) 0 0 var(--raio-pilula);
  }

  .meia--direita {
    border-radius: 0 var(--raio-pilula) var(--raio-pilula) 0;
  }

  .meia--menta { background-color: var(--menta); }
  .meia--magenta { background-color: var(--magenta); }
  .meia--violeta { background-color: var(--violeta); }

  .arco {
    inline-size: 7rem;
    aspect-ratio: 4 / 5;
    border-radius: var(--raio-arco);
    background-color: var(--navy);
    background-image:
      radial-gradient(60% 50% at 15% 12%, color-mix(in oklab, var(--magenta) 85%, transparent), transparent 70%),
      radial-gradient(70% 55% at 80% 30%, color-mix(in oklab, var(--violeta) 90%, transparent), transparent 70%),
      radial-gradient(60% 50% at 70% 95%, color-mix(in oklab, var(--menta) 80%, transparent), transparent 70%);
  }

  .nove {
    inline-size: 4rem;
    color: var(--magenta);
  }

  .bloco-escuro {
    padding-block: var(--secao);
  }

  .bloco-escuro__grade {
    display: grid;
    gap: var(--e-5);
    justify-items: start;
  }

  .bloco-escuro__grade p {
    max-inline-size: var(--medida);
  }
</style>
