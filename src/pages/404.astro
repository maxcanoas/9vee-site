---
// A página de erro leva aos serviços: os dois grupos do menu, cada um na cor do seu público, com o nome e a
// descrição de cada link, como no painel do cabeçalho.
import Base from '../layouts/Base.astro';
import Texto from '../components/Texto.astro';
import { dadosDoSite } from '../lib/site';

const { erro404, menu } = await dadosDoSite();
---

<Base pagina="erro404" titulo={erro404.titulo} descricao={erro404.descricao}>
  <div class="conteiner erro">
    <h1><Texto de={erro404.h1} /></h1>
    <p class="texto-secundario"><Texto de={erro404.texto} /></p>

    <nav class="erro__caminhos" aria-label={erro404.rotuloCaminhos}>
      {
        menu.grupos.map((grupo) => (
          <div data-grupo={grupo.id}>
            <h2 class="erro__grupo">
              <span class="grifo">{grupo.rotulo}</span>
            </h2>
            <ul class="erro__lista" role="list">
              {grupo.itens.map((item) => (
                <li>
                  <a class="erro__link" href={item.href}>
                    <span class="erro__servico">
                      <Texto de={item.rotulo} />
                    </span>
                    {item.descricao && (
                      <span class="erro__descricao">
                        <Texto de={item.descricao} />
                      </span>
                    )}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </nav>

    <a class="botao" href="/">{erro404.voltar}</a>
  </div>
</Base>

<style>
  .erro {
    display: grid;
    gap: var(--e-5);
    justify-items: start;
    padding-block: var(--secao);
  }

  .erro__caminhos {
    display: grid;
    gap: var(--e-6);
    inline-size: 100%;
    margin-block: var(--e-4);
  }

  .erro__grupo {
    margin-block-end: var(--e-4);
    font-size: var(--t-destaque);
    letter-spacing: 0;
  }

  .erro__lista {
    display: grid;
    gap: var(--e-4);
    padding: 0;
    list-style: none;
  }

  .erro__link {
    display: grid;
    gap: var(--e-1);
    min-block-size: var(--alvo-minimo);
    text-decoration: none;
  }

  .erro__servico {
    font-family: var(--fonte-titulo);
    font-size: var(--t-destaque);
    font-weight: 600;
    line-height: var(--altura-subtitulo);
    text-decoration-line: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: var(--sublinhado-destaque);
    text-underline-offset: 0.2em;
    transition-property: text-decoration-color;
    transition-duration: var(--dur-rapida);
  }

  .erro__link:hover .erro__servico {
    text-decoration-color: var(--magenta);
  }

  .erro__descricao {
    color: var(--navy-2);
    font-size: var(--t-pequeno);
  }

  @media (min-width: 48rem) {
    .erro__caminhos {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--e-7);
    }
  }
</style>
