---
import Base from '../layouts/Base.astro';
import Trilha from '../components/Trilha.astro';
import Texto from '../components/Texto.astro';
import { paginaPrivacidade } from '../lib/paginas';

const { data: pagina } = await paginaPrivacidade();
---

<Base pagina="privacidade" titulo={pagina.seo.titulo} descricao={pagina.seo.descricao}>
  <article class="conteiner politica">
    <header class="politica__topo">
      <Trilha />
      <h1><Texto de={pagina.h1} /></h1>
      <p class="politica__apoio texto-secundario"><Texto de={pagina.apoio} /></p>
    </header>

    {/* A legenda das marcas, enquanto o cliente revisa a mescla com a política do Wix. A trava barra a classe revisao. */}
    {
      pagina.revisao && (
        <aside class="politica__legenda revisao" aria-labelledby="revisao-titulo">
          <h2 id="revisao-titulo">
            <Texto de={pagina.revisao.titulo} />
          </h2>
          <p>
            <Texto de={pagina.revisao.texto} />
          </p>
        </aside>
      )
    }

    {
      pagina.secoes.map((secao) => (
        <section
          class:list={['politica__secao', secao.novo && 'politica__secao--nova revisao']}
          id={secao.id}
          aria-labelledby={`${secao.id}-titulo`}
        >
          <h2 id={`${secao.id}-titulo`}>
            <Texto de={secao.titulo} />
            {secao.novo && pagina.revisao && <span class="politica__etiqueta">{pagina.revisao.etiqueta}</span>}
          </h2>
          {secao.blocos.map((bloco) =>
            typeof bloco === 'string' ? (
              <p>
                <Texto de={bloco} />
              </p>
            ) : (
              <ul class="politica__lista">
                {bloco.itens.map((item) => (
                  <li>
                    <Texto de={item} />
                  </li>
                ))}
              </ul>
            ),
          )}
        </section>
      ))
    }

    <p class="texto-secundario"><Texto de={pagina.versao} /></p>
  </article>
</Base>

<style>
  .politica {
    display: grid;
    gap: var(--e-6);
    padding-block: var(--e-7) var(--secao);
  }

  .politica__topo {
    display: grid;
    gap: var(--e-5);
  }

  /* Título de documento, e não de hero: a página é para ler, e o título grande das outras empurraria o texto para
     baixo da primeira tela. */
  .politica__topo h1 {
    font-size: var(--t-2);
  }

  .politica__apoio {
    max-inline-size: 48ch;
    font-size: var(--t-destaque);
    line-height: var(--altura-apoio);
  }

  .politica__secao {
    display: grid;
    gap: var(--e-4);
    max-inline-size: var(--medida);
  }

  .politica__secao h2 {
    font-size: var(--t-3);
    line-height: var(--altura-subtitulo);
    letter-spacing: 0;
  }

  .politica__lista {
    display: grid;
    gap: var(--e-2);
    padding-inline-start: var(--e-5);
  }

  /* A revisão com o cliente: a caixa que explica as marcas e a seção que entrou inteira, com a mesma faixa menta do
     trecho novo (ins.revisao, no base.css). */
  .politica__legenda,
  .politica__secao--nova {
    padding: var(--e-5);
    border-inline-start: var(--fio-revisao) solid var(--menta);
    background-color: var(--menta-veu);
  }

  .politica__legenda {
    display: grid;
    gap: var(--e-2);
    max-inline-size: var(--medida);
  }

  .politica__legenda h2 {
    font-size: var(--t-destaque);
    letter-spacing: 0;
  }

  .politica__etiqueta {
    display: inline-block;
    margin-inline-start: var(--e-2);
    padding-block: var(--e-etiqueta-bloco);
    padding-inline: var(--e-etiqueta-linha);
    border: 1px solid var(--menta);
    border-radius: var(--raio-pilula);
    background-color: var(--menta-revisao);
    color: var(--navy);
    font-family: var(--fonte-texto);
    font-size: var(--t-etiqueta);
    font-weight: 700;
    line-height: var(--altura-etiqueta);
    vertical-align: var(--etiqueta-no-titulo);
  }
</style>
