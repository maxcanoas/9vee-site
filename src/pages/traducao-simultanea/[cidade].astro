---
// As páginas das cidades onde só a tradução é presencial, dentro da Tradução Simultânea.
import Cidade from '../../layouts/Cidade.astro';
import { paginasDeCidade, type PaginaDeCidade } from '../../lib/paginas';

export async function getStaticPaths() {
  return (await paginasDeCidade())
    .filter((pagina) => pagina.conteudo.tipo === 'traducao')
    .map((pagina) => ({ params: { cidade: pagina.id }, props: pagina }));
}

type Props = PaginaDeCidade;
---

<Cidade {...Astro.props} />
