---
// As páginas das cidades onde só a tradução é presencial, dentro da Tradução Simultânea.
import PaginaDeCidade from '../../layouts/PaginaDeCidade.astro';
import { paginasDeCidade, type PaginaDeCidade as Pagina } from '../../lib/paginas';

export async function getStaticPaths() {
  return (await paginasDeCidade())
    .filter((pagina) => pagina.conteudo.tipo === 'traducao')
    .map((pagina) => ({ params: { cidade: pagina.id }, props: pagina }));
}

type Props = Pagina;
---

<PaginaDeCidade {...Astro.props} />
