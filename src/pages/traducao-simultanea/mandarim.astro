---
// A interpretação de mandarim para o mercado financeiro, filha da Tradução Simultânea. Não é a página do curso de
// mandarim: o pedido dela é o de tradução, com o mandarim já marcado nos idiomas do evento.
import Base from '../../layouts/Base.astro';
import HeroPagina from '../../components/HeroPagina.astro';
import ListaGrande from '../../components/ListaGrande.astro';
import Mostra from '../../components/Mostra.astro';
import Chamada from '../../components/Chamada.astro';
import CtaFinal from '../../components/CtaFinal.astro';
import { dadosDoSite, idiomaDaPagina } from '../../lib/site';
import { enderecoDoCurso, paginaInterpretacaoDeMandarim } from '../../lib/paginas';
import { servico } from '../../lib/jsonld';

const { data: pagina } = await paginaInterpretacaoDeMandarim();
const site = await dadosDoSite();
const base = Astro.site ?? new URL(Astro.url.origin);
// Do idioma da página saem o lang da assinatura, a cor da família dele no grifo e o endereço do curso.
const idioma = idiomaDaPagina(site, 'interpretacaoDeMandarim');
const { assinatura, ...tese } = pagina.tese;
const { link: rotuloDoCurso, ...curso } = pagina.curso;
// A landing do site atual fala de visitas e tours em fábricas e escritórios no Brasil: a área atendida é o país.
const jsonLd = [
  servico(base, {
    nome: pagina.servico.nome,
    tipo: pagina.servico.tipo,
    caminho: Astro.url.pathname,
    descricao: pagina.seo.descricao,
  }),
];
---

<Base pagina="interpretacaoDeMandarim" titulo={pagina.seo.titulo} descricao={pagina.seo.descricao} jsonLd={jsonLd}>
  <HeroPagina {...pagina.hero} servico="traducao" nota={pagina.prazo} />
  <ListaGrande id="servicos" {...pagina.servicos} />
  <Mostra id="precisao" {...tese} assinatura={{ texto: assinatura, lang: idioma.lang }} grupo={idioma.familia} />
  <Chamada id="curso" {...curso} link={{ rotulo: rotuloDoCurso, href: await enderecoDoCurso(idioma.slug) }} />
  <CtaFinal {...pagina.ctaFinal} servico="traducao" nota={pagina.prazo} />
</Base>
