---
import Base from '../layouts/Base.astro';
import HeroPagina from '../components/HeroPagina.astro';
import FaixaDeAtalhos from '../components/FaixaDeAtalhos.astro';
import TextoComImagem from '../components/TextoComImagem.astro';
import Mostra from '../components/Mostra.astro';
import Pontos from '../components/Pontos.astro';
import Chamada from '../components/Chamada.astro';
import Definicoes from '../components/Definicoes.astro';
import ListaCorrida from '../components/ListaCorrida.astro';
import CtaFinal from '../components/CtaFinal.astro';
import PassosNumerados from '../components/PassosNumerados.astro';
import { dadosDoSite, servicoDoSite } from '../lib/site';
import { paginaLms } from '../lib/paginas';
import { servico } from '../lib/jsonld';
import { GRUPO_DO_PUBLICO } from '../lib/publico';

const { data: pagina } = await paginaLms();
const { itens: perguntasDoPedido, ...fechamento } = pagina.ctaFinal;
const site = await dadosDoSite();
const base = Astro.site ?? new URL(Astro.url.origin);
const jsonLd = [
  servico(base, {
    nome: servicoDoSite(site, 'lms').nome,
    tipo: pagina.servico.tipo,
    caminho: Astro.url.pathname,
    descricao: pagina.seo.descricao,
  }),
];
---

<Base pagina="lms" titulo={pagina.seo.titulo} descricao={pagina.seo.descricao} jsonLd={jsonLd}>
  <HeroPagina {...pagina.hero} servico="lms" />
  {/* Os ids das seções são as âncoras dos atalhos, em content/lms.md. */}
  <FaixaDeAtalhos id="motivos" {...pagina.motivos} />
  <TextoComImagem id="o-que-e" {...pagina.oQueE} />
  <Mostra id="plataforma" {...pagina.plataforma} grupo={GRUPO_DO_PUBLICO.empresa} />
  <Pontos id="relatorios" {...pagina.relatorios} />
  <Chamada id="chamada" {...pagina.chamada} servico="lms" />
  <Definicoes id="metodologia" {...pagina.metodologia} />
  <ListaCorrida id="setores" {...pagina.setores} />
  <CtaFinal {...fechamento} servico="lms">
    <PassosNumerados itens={perguntasDoPedido} />
  </CtaFinal>
</Base>
