---
import Base from '../layouts/Base.astro';
import HeroPagina from '../components/HeroPagina.astro';
import Cartoes from '../components/Cartoes.astro';
import { dadosDoSite } from '../lib/site';
import { paginaParcial } from '../lib/paginas';

const { data: pagina } = await paginaParcial('lms');
const site = await dadosDoSite();
---

<Base pagina="lms" titulo={pagina.seo.titulo} descricao={pagina.seo.descricao}>
  <HeroPagina {...pagina.hero} servico="lms" etiqueta={site.etiquetaMvp} />
  <Cartoes id="pedido" {...pagina.bloco} servico="lms" />
</Base>
