---
import Base from '../layouts/Base.astro';
import HeroPagina from '../components/HeroPagina.astro';
import Comparacao from '../components/Comparacao.astro';
import TextoComImagem from '../components/TextoComImagem.astro';
import Pontos from '../components/Pontos.astro';
import ListaCorrida from '../components/ListaCorrida.astro';
import Definicoes from '../components/Definicoes.astro';
import Chamada from '../components/Chamada.astro';
import Faq from '../components/Faq.astro';
import CtaFinal from '../components/CtaFinal.astro';
import { dadosDoSite, servicoDoSite } from '../lib/site';
import { paginaTraducao } from '../lib/paginas';
import { faqPage, servico } from '../lib/jsonld';

const { data: pagina } = await paginaTraducao();
const site = await dadosDoSite();
const base = Astro.site ?? new URL(Astro.url.origin);
// Com a interpretação remota, pelo Zoom e por telefone, e os intérpretes que a 9vee busca na cidade do evento, a área
// atendida é o país (perguntas 15 e 25, respondidas em 05/10/2026). As quatro cidades do presencial ficam no texto.
const jsonLd = [
  servico(base, {
    nome: servicoDoSite(site, 'traducao').nome,
    tipo: pagina.servico.tipo,
    caminho: Astro.url.pathname,
    descricao: pagina.seo.descricao,
  }),
  faqPage(pagina.faq.itens),
];
const { idiomas, cidades, ...atendimento } = pagina.atendimento;
---

<Base pagina="traducao" titulo={pagina.seo.titulo} descricao={pagina.seo.descricao} jsonLd={jsonLd}>
  <HeroPagina {...pagina.hero} servico="traducao" />
  <Comparacao id="formatos" {...pagina.formatos} />
  <TextoComImagem id="como-funciona" {...pagina.comoFunciona} />
  <Pontos id="eventos" {...pagina.eventos} servico="traducao" />
  <ListaCorrida id="idiomas-e-cidades" {...atendimento} grupos={[idiomas, { ...cidades, itens: site.cidades }]} />
  <Definicoes id="interpretes" {...pagina.interpretes} />
  <Chamada id="mandarim" {...pagina.mandarim} escuro />
  <Faq {...pagina.faq} />
  <CtaFinal {...pagina.ctaFinal} servico="traducao" />
</Base>
