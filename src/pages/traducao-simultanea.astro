---
import Base from '../layouts/Base.astro';
import HeroPagina from '../components/HeroPagina.astro';
import Cartoes from '../components/Cartoes.astro';
import { dadosDoSite } from '../lib/site';
import { paginaParcial } from '../lib/paginas';

const { data: pagina } = await paginaParcial('traducao-simultanea');
const site = await dadosDoSite();
---

<Base pagina="traducao" titulo={pagina.seo.titulo} descricao={pagina.seo.descricao}>
  <HeroPagina {...pagina.hero} servico="traducao" etiqueta={site.etiquetaMvp} />
  <Cartoes id="formatos" {...pagina.bloco} servico="traducao" />
</Base>
