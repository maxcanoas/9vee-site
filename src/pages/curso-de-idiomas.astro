---
import Base from '../layouts/Base.astro';
import HeroPagina from '../components/HeroPagina.astro';
import Familias from '../components/Familias.astro';
import Niveis from '../components/Niveis.astro';
import Cartoes from '../components/Cartoes.astro';
import Acordeao from '../components/Acordeao.astro';
import Pontos from '../components/Pontos.astro';
import Chamada from '../components/Chamada.astro';
import ComoComeca from '../components/ComoComeca.astro';
import Faq from '../components/Faq.astro';
import CtaFinal from '../components/CtaFinal.astro';
import CabecaDeSecao from '../components/CabecaDeSecao.astro';
import { dadosDoSite } from '../lib/site';
import { enderecoDasCidadesPublicadas, enderecoDosIdiomasPublicados, paginaIdiomas } from '../lib/paginas';
import { ligarCidades } from '../lib/cidades';
import { faqPage, listaDeCursos } from '../lib/jsonld';

const { data: pagina } = await paginaIdiomas();
const site = await dadosDoSite();
const enderecosDosIdiomas = await enderecoDosIdiomasPublicados();
const base = Astro.site ?? new URL(Astro.url.origin);
// A nota da aula presencial leva à página da cidade, quando ela está publicada.
const cidadesComAula = await enderecoDasCidadesPublicadas('idiomas');
const formatos = { ...pagina.formatos, nota: ligarCidades(pagina.formatos.nota, cidadesComAula) };
const idiomas = site.idiomas.map((idioma) => ({ ...idioma, pagina: enderecosDosIdiomas.get(idioma.slug) }));
const jsonLd = [
  listaDeCursos(base, { caminho: Astro.url.pathname, modelos: pagina.curso, idiomas }),
  faqPage(pagina.faq.itens),
];
---

<Base pagina="idiomas" titulo={pagina.seo.titulo} descricao={pagina.seo.descricao} jsonLd={jsonLd}>
  <HeroPagina {...pagina.hero} textos={site.cta} servico="idiomas" />

  <section class="idiomas" id="idiomas" aria-labelledby="idiomas-titulo">
    <div class="conteiner idiomas__corpo">
      <CabecaDeSecao id="idiomas" titulo={pagina.idiomas.titulo} apoio={pagina.idiomas.apoio} class="idiomas__cabeca" />
      <Familias
        familias={site.familias}
        idiomas={site.idiomas}
        modo="pedido"
        rotuloPedido={pagina.idiomas.rotuloPedido}
        enderecos={enderecosDosIdiomas}
      />
    </div>
  </section>

  <Niveis {...pagina.niveis} />
  <Acordeao id="provas" {...pagina.provas} />

  {/* Os dois blocos de formato trocam de lugar com o público, como a spec pede.
      Esta é a vitrine de quem estuda por conta própria, então sem escolha valem os formatos primeiro.
      Os três passos até a primeira aula andam com os formatos: quem estuda lê como são as aulas e como começa em
      seguida, sem o bloco da empresa no meio. O Inglês Acessível, a realocação e a ponte para o LMS são de instituição
      e de empresa: andam junto com o bloco dela. */}
  <div class="modalidades" data-ordenavel="voce">
    <div class="modalidade" data-ordem-empresa="2" data-ordem-voce="1">
      <Cartoes id="formatos" {...formatos} servico="idiomas" />
      <ComoComeca {...pagina.como} />
    </div>
    <div class="modalidade" data-ordem-empresa="1" data-ordem-voce="2">
      <Pontos id="empresas" {...pagina.equipe} servico="idiomas" />
      <Chamada id="ingles-acessivel" {...pagina.inglesAcessivel} servico="idiomas" />
      <Chamada id="realocacao" {...pagina.realocacao} />
      <Chamada id="plataforma" {...pagina.lms} />
    </div>
  </div>

  <Faq {...pagina.faq} />
  <CtaFinal {...pagina.ctaFinal} cta={site.cta} servico="idiomas" />
</Base>

<style>
  .idiomas {
    padding-block: var(--secao);
  }

  .idiomas__corpo {
    display: grid;
    gap: var(--e-4);
  }

  .idiomas__cabeca {
    margin-block-end: var(--e-5);
  }

  /* Grid só para o `order` valer: o JavaScript também move os blocos no DOM,
     para a ordem do Tab bater com a da tela. */
  .modalidades {
    display: grid;
  }

  .modalidade[data-ordem-voce='1'] { order: 1; }
  .modalidade[data-ordem-voce='2'] { order: 2; }
  :global(:root[data-publico='empresa']) .modalidade[data-ordem-empresa='1'] { order: 1; }
  :global(:root[data-publico='empresa']) .modalidade[data-ordem-empresa='2'] { order: 2; }
</style>
