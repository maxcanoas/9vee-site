---
// Uma página por idioma, com o texto de content/idiomas/. Entra no build pela regra de publicação (a produção só
// leva as publicadas), e cada uma mostra só as seções que o conteúdo dela tem, na ordem da spec.
import Base from '../../layouts/Base.astro';
import TopoIdioma from '../../components/TopoIdioma.astro';
import Cartoes from '../../components/Cartoes.astro';
import Niveis from '../../components/Niveis.astro';
import Definicoes from '../../components/Definicoes.astro';
import Pontos from '../../components/Pontos.astro';
import Chamada from '../../components/Chamada.astro';
import Faq from '../../components/Faq.astro';
import Depoimentos from '../../components/Depoimentos.astro';
import CtaFinal from '../../components/CtaFinal.astro';
import { dadosDoSite } from '../../lib/site';
import { enderecoDasCidadesPublicadas, paginaIdiomas, paginasDeIdioma, type PaginaDeIdioma } from '../../lib/paginas';
import { ligarCidades } from '../../lib/cidades';
import { curso, faqPage, nomeDoCurso } from '../../lib/jsonld';
import { minuscula, preencher } from '../../lib/texto';

export async function getStaticPaths() {
  return (await paginasDeIdioma()).map((pagina) => ({ params: { pagina: pagina.id }, props: pagina }));
}

type Props = PaginaDeIdioma;

const { idioma, conteudo } = Astro.props;
const site = await dadosDoSite();
const { data: cursos } = await paginaIdiomas();
const base = Astro.site ?? new URL(Astro.url.origin);
const jsonLd = [
  curso(base, {
    nome: nomeDoCurso(cursos.curso.nome, idioma.nome),
    descricao: conteudo.seo.descricao,
    caminho: Astro.url.pathname,
  }),
  ...(conteudo.faq ? [faqPage(conteudo.faq.itens)] : []),
];
// Onde a aula presencial cita a cidade, ela leva à página da cidade, quando publicada.
const cidadesComAula = await enderecoDasCidadesPublicadas('idiomas');
const ligar = (texto: string) => ligarCidades(texto, cidadesComAula);
// Os depoimentos que citam este idioma, de content/site.md, logo depois das provas: são a prova de quem já estudou.
const depoimentos = site.depoimentos.itens.filter((depoimento) => depoimento.idiomas?.includes(idioma.slug));
const formatos = conteudo.formatos && {
  ...conteudo.formatos,
  nota: ligar(conteudo.formatos.nota),
  itens: conteudo.formatos.itens.map((item) => ({ ...item, texto: ligar(item.texto) })),
};
---

<Base pagina="idioma" idioma={idioma} titulo={conteudo.seo.titulo} descricao={conteudo.seo.descricao} jsonLd={jsonLd}>
  <TopoIdioma {...conteudo.topo} idioma={idioma} etiqueta={conteudo.publicada ? undefined : site.naoPublicada} />
  {conteudo.paraQuem && <Cartoes id="para-quem" {...conteudo.paraQuem} />}
  {conteudo.niveis && <Niveis {...conteudo.niveis} />}
  {formatos && <Pontos id="formatos" {...formatos} />}
  {conteudo.provas && <Definicoes id="provas" {...conteudo.provas} />}
  {
    depoimentos.length > 0 && (
      <Depoimentos
        titulo={preencher(site.depoimentos.rotulos.noIdioma, { idioma: minuscula(idioma.nome) })}
        itens={depoimentos}
        rotulos={site.depoimentos.rotulos}
      />
    )
  }
  {conteudo.destaque && <Pontos {...conteudo.destaque} />}
  {conteudo.realocacao && <Chamada id="realocacao" {...cursos.realocacao} />}
  {conteudo.faq && <Faq {...conteudo.faq} />}
  <CtaFinal {...conteudo.ctaFinal} cta={conteudo.topo.cta} servico="idiomas" idioma={idioma.slug} />
</Base>
