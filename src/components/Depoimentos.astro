---
// Trecho literal de cada fala, sem reescrever, com nome, cargo e empresa. Sem estrelas.
// O logo da empresa vai ao lado do nome e fica escondido do leitor de tela, que já ouve a empresa na linha do cargo.
// Os depoimentos correm numa faixa de lado (09/10/2026): um cartão por vez no celular, com a ponta do próximo à vista,
// e dois no computador. A pessoa passa com o dedo, com as setas ou com as setas do teclado na faixa. Nada anda
// sozinho: depoimento é texto para ler. Sem JavaScript, a faixa continua rolando, e as setas e os pontos somem.
import Texto from './Texto.astro';
import LogoEmpresa from './LogoEmpresa.astro';

interface Depoimento {
  trecho: string;
  lingua?: string;
  traducao?: string;
  nome: string;
  cargo: string;
  empresa: string;
  logo?: string;
  servico: string;
  pendencia?: string;
}

interface Props {
  id?: string;
  titulo: string;
  itens: Depoimento[];
  rotulos: { autorizacao: string; traducao: string; anterior: string; proximo: string };
}

const { id = 'depoimentos', titulo, itens, rotulos } = Astro.props;
const trilho = `${id}-trilho`;
---

<section class="depoimentos" id={id} aria-labelledby={`${id}-titulo`} data-carrossel>
  <div class="conteiner">
    <h2 id={`${id}-titulo`} class="depoimentos__titulo revela"><Texto de={titulo} /></h2>

    {/* Focável, para quem usa o teclado rolar a faixa com as setas: os cartões não têm nada que receba o foco. */}
    <ul class="depoimentos__trilho" id={trilho} role="list" tabindex="0" aria-labelledby={`${id}-titulo`} data-carrossel-trilho>
      {
        itens.map((depoimento) => (
          <li class="depoimento">
            <figure class="depoimento__figura">
              <blockquote class="depoimento__fala" lang={depoimento.lingua}>
                <p>
                  “<Texto de={depoimento.trecho} />”
                </p>
              </blockquote>
              {depoimento.traducao && (
                <p class="depoimento__traducao">
                  <span class="depoimento__rotulo-traducao">{rotulos.traducao}</span> “<Texto de={depoimento.traducao} />”
                </p>
              )}
              <figcaption class="depoimento__autor">
                {depoimento.logo && (
                  <span class="depoimento__logo">
                    <LogoEmpresa nome={depoimento.logo} />
                  </span>
                )}
                <span class="depoimento__nome">
                  <Texto de={depoimento.nome} />
                </span>
                <span class="depoimento__cargo">
                  <Texto de={`${depoimento.cargo}, ${depoimento.empresa}`} />
                </span>
                <span class="depoimento__servico">
                  <Texto de={depoimento.servico} />
                </span>
                {depoimento.pendencia && (
                  <span class="depoimento__autorizacao">
                    <Texto de={`${rotulos.autorizacao} ${depoimento.pendencia}`} />
                  </span>
                )}
              </figcaption>
            </figure>
          </li>
        ))
      }
    </ul>

    {/* Embaixo da faixa, perto do polegar. Os pontos dizem onde ela está, só para a vista: quem usa leitor de tela ouve
        os depoimentos em ordem, na lista. As setas andam um cartão. */}
    <div class="depoimentos__controles">
      <div class="depoimentos__pontos" aria-hidden="true" data-carrossel-pontos></div>
      <div class="depoimentos__setas">
        <button type="button" class="depoimentos__seta" aria-controls={trilho} aria-label={rotulos.anterior} data-carrossel-anterior>
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M15 5l-7 7 7 7" /></svg>
        </button>
        <button type="button" class="depoimentos__seta" aria-controls={trilho} aria-label={rotulos.proximo} data-carrossel-proximo>
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M9 5l7 7-7 7" /></svg>
        </button>
      </div>
    </div>
  </div>
</section>

<script>
  import '../scripts/carrossel.ts';
</script>

<style>
  .depoimentos {
    padding-block: var(--secao);
    background-color: var(--nevoa);
  }

  .depoimentos__titulo {
    margin-block-end: var(--e-6);
  }

  .depoimentos__controles {
    display: flex;
    gap: var(--e-4);
    align-items: center;
    justify-content: space-between;
    margin-block-start: var(--e-5);
  }

  .depoimentos__setas {
    display: flex;
    gap: var(--e-3);
  }

  .depoimentos__seta {
    display: grid;
    place-items: center;
    inline-size: var(--alvo-minimo);
    block-size: var(--alvo-minimo);
    padding: 0;
    border: 1.5px solid currentColor;
    border-radius: var(--raio-pilula);
    background-color: transparent;
    color: var(--navy);
    cursor: pointer;
    transition-property: background-color, opacity;
    transition-duration: var(--dur-rapida);
  }

  .depoimentos__seta:hover {
    background-color: var(--papel);
  }

  .depoimentos__seta svg {
    inline-size: 1.25rem;
    block-size: 1.25rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Na ponta da faixa, a seta continua focável, para o foco não cair no corpo da página, mas não anda. */
  .depoimentos__seta[aria-disabled='true'] {
    opacity: 0.35;
    cursor: default;
  }

  .depoimentos__seta[aria-disabled='true']:hover {
    background-color: transparent;
  }

  /* Sem JavaScript as setas não andam, e quando todos os depoimentos cabem não há para onde ir: os controles somem.
     A faixa continua rolando com o dedo e com a barra. */
  :global(:root:not(.js)) .depoimentos__controles,
  [data-cabe] .depoimentos__controles {
    display: none;
  }

  /* Um cartão e a ponta do próximo no celular. A barra só aparece sem JavaScript, quando é o único jeito de rolar
     no computador. */
  .depoimentos__trilho {
    display: grid;
    grid-auto-columns: 86%;
    grid-auto-flow: column;
    gap: var(--e-4);
    margin: 0;
    padding: 0;
    list-style: none;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
  }

  :global(:root.js) .depoimentos__trilho {
    scrollbar-width: none;
  }

  :global(:root.js) .depoimentos__trilho::-webkit-scrollbar {
    display: none;
  }

  .depoimentos__trilho:focus-visible {
    outline-offset: var(--e-1);
  }

  /* Os cartões têm a altura do mais alto, e o autor desce para o pé: os nomes ficam na mesma linha. Com cada cartão
     da altura do próprio texto, o curto boiava no alto da faixa, com um vão embaixo. */
  .depoimento {
    display: grid;
    padding: var(--e-5);
    background-color: var(--papel);
    scroll-snap-align: start;
  }

  .depoimento__figura {
    display: flex;
    flex-direction: column;
    gap: var(--e-4);
    margin: 0;
  }

  .depoimento__fala {
    margin: 0;
    font-family: var(--fonte-titulo);
    font-size: var(--t-destaque);
    font-weight: 600;
    line-height: var(--altura-subtitulo);
    text-wrap: pretty;
  }

  .depoimento__traducao {
    color: var(--navy-2);
    font-size: var(--t-pequeno);
    text-wrap: pretty;
  }

  .depoimento__rotulo-traducao {
    font-weight: 700;
  }

  .depoimento__autor {
    display: grid;
    gap: var(--e-1);
    margin-block-start: auto;
    padding-block-start: var(--e-2);
  }

  .depoimento__autor:has(.depoimento__logo) {
    grid-template-columns: auto 1fr;
    column-gap: var(--e-4);
  }

  .depoimento__autor:has(.depoimento__logo) :is(.depoimento__nome, .depoimento__cargo, .depoimento__servico) {
    grid-column: 2;
  }

  /* O 3 são as linhas de nome, cargo e serviço: se entrar outra linha ao lado do logo, ele muda aqui. */
  .depoimento__logo {
    grid-row: 1 / span 3;
    align-self: center;
  }

  .depoimento__nome {
    font-weight: 700;
  }

  .depoimento__cargo,
  .depoimento__servico {
    color: var(--navy-2);
  }

  .depoimento__servico {
    font-size: var(--t-pequeno);
  }

  .depoimento__autorizacao {
    grid-column: 1 / -1;
    margin-block-start: var(--e-2);
    color: var(--navy-2);
    font-size: var(--t-pequeno);
  }

  /* Os pontos dizem onde a faixa está: o atual é mais largo. Eles nascem no script, que sabe quantas paradas há. */
  .depoimentos__pontos {
    display: flex;
    gap: var(--e-2);
  }

  .depoimentos__pontos :global(span) {
    inline-size: 0.5rem;
    block-size: 0.5rem;
    border-radius: var(--raio-pilula);
    background-color: color-mix(in oklab, var(--navy) 25%, transparent);
    transition-property: inline-size, background-color;
    transition-duration: var(--dur-media);
  }

  .depoimentos__pontos :global(span[data-atual]) {
    inline-size: 1.5rem;
    background-color: var(--navy);
  }

  @media (prefers-reduced-motion: reduce) {
    .depoimentos__pontos :global(span) {
      transition: none;
    }
  }

  @media (min-width: 48rem) {
    .depoimentos__trilho {
      grid-auto-columns: calc((100% - var(--e-5)) / 2);
      gap: var(--e-5);
    }

    .depoimento {
      padding: var(--e-6);
    }
  }
</style>
