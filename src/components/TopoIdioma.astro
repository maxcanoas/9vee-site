---
// O topo das páginas de idioma: a saudação na escrita do idioma, com a meia-lua na cor da família, como na faixa de
// saudações da home, e a foto do lugar em arco, com o círculo da marca atrás, como nas páginas internas. A meia-lua
// vira o lado reto para o círculo, que aparece por cima do arco: são as duas metades que se encontram, a forma da marca.
import Texto from './Texto.astro';
import BotaoContato from './BotaoContato.astro';
import ArcoComCirculo from './ArcoComCirculo.astro';
import Trilha from './Trilha.astro';
import AvisoNaoPublicada from './AvisoNaoPublicada.astro';
import type { TextosPorPublico } from '../lib/publico';
import type { Imagem } from '../content.config';

interface Props {
  h1: string;
  apoio: string;
  cta: TextosPorPublico;
  /** A foto do lugar: duas pessoas conversando numa cidade onde se fala o idioma, com um marco ao fundo. A legenda
   *  é a cidade e o país, que aparecem embaixo dela. */
  imagem: Imagem & { legenda: string };
  idioma: { slug: string; saudacao: string; lang: string; dir?: 'rtl'; familia: string };
  /** O aviso da página que ainda não vai para o site. A produção sai sem essas páginas: só o local e o preview o mostram. */
  etiqueta?: string;
}

const { h1, apoio, cta, imagem, idioma, etiqueta } = Astro.props;
const { legenda, ...foto } = imagem;
---

<section class="topo-idioma escuro tons-claros" aria-labelledby="hero-titulo" data-grupo={idioma.familia}>
  <div class="conteiner topo-idioma__grade">
    <div class="topo-idioma__texto">
      <Trilha />
      {etiqueta && <AvisoNaoPublicada texto={etiqueta} />}
      <p class="topo-idioma__saudacao" lang={idioma.lang} dir={idioma.dir}>{idioma.saudacao}</p>
      <h1 id="hero-titulo"><Texto de={h1} /></h1>
      <p class="topo-idioma__apoio"><Texto de={apoio} /></p>
      <BotaoContato textos={cta} servico="idiomas" idioma={idioma.slug} />
    </div>
    <ArcoComCirculo imagem={foto} legenda={legenda} />
  </div>
</section>

<style>
  /* O respiro de cima é o do hero das páginas internas: a trilha ocupa o alto, e o botão cabe na primeira tela. */
  .topo-idioma {
    padding-block: var(--e-7) var(--secao);
  }

  /* O espaço do hero das páginas internas: o círculo sobe acima do arco e precisa de folga do botão. */
  .topo-idioma__grade {
    display: grid;
    gap: var(--e-7);
  }

  .topo-idioma__texto {
    display: grid;
    gap: var(--e-5);
    justify-items: start;
  }

  .topo-idioma__saudacao {
    display: inline-flex;
    align-items: center;
    gap: var(--e-5);
    font-family: var(--fonte-titulo);
    font-size: var(--t-mostra);
    font-weight: 600;
    line-height: 1.1;
    unicode-bidi: isolate;
  }

  .topo-idioma__saudacao::after {
    content: '';
    flex: none;
    inline-size: 0.18em;
    block-size: 0.36em;
    border-radius: var(--raio-pilula) 0 0 var(--raio-pilula);
    background-color: var(--cor-grupo);
  }

  /* No árabe o elemento corre da direita para a esquerda, e o flex poria a meia-lua antes da palavra. O eixo
     invertido a deixa depois, do lado do círculo, como nas outras línguas. */
  .topo-idioma__saudacao[dir='rtl'] {
    flex-direction: row-reverse;
  }

  .topo-idioma__texto h1 {
    max-inline-size: 16ch;
  }

  .topo-idioma__apoio {
    max-inline-size: 46ch;
    color: var(--sobre-escuro);
    font-size: var(--t-destaque);
    line-height: var(--altura-apoio);
  }

  @media (min-width: 64rem) {
    .topo-idioma__grade {
      grid-template-columns: 1.15fr 0.85fr;
      align-items: center;
      column-gap: var(--e-8);
    }
  }

  /* Notebook de tela baixa, como no hero das páginas internas: com a saudação em tipo de mostra, o botão do
     português ficava abaixo da primeira tela. */
  @media (min-width: 64rem) and (max-height: 48rem) {
    .topo-idioma {
      padding-block-start: var(--e-6);
    }

    .topo-idioma__texto {
      gap: var(--e-4);
    }
  }
</style>
