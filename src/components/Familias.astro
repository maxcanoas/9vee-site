---
// Os 14 idiomas por família, cada um com o olá na própria língua (e o lang certo, para a letra certa).
// Na home, cada idioma é um link para a página de cursos; lá, cada idioma é um botão que abre o pedido
// com ele já marcado, e uma âncora, porque é para lá que os links da home apontam.
// Sem JavaScript o botão some (regra do base.css), e o <noscript> mantém a lista à vista.
import Texto from './Texto.astro';
import { atributosDoContato } from '../lib/contato';

interface Familia {
  id: string;
  nome: string;
  descricao: string;
}

interface Idioma {
  slug: string;
  nome: string;
  saudacao: string;
  lang: string;
  dir?: 'rtl';
  familia: string;
}

interface Props {
  familias: Familia[];
  idiomas: Idioma[];
  modo: 'links' | 'pedido';
  /** Modo "pedido": o que o leitor de tela ouve depois do nome do idioma. */
  rotuloPedido?: string;
}

const { familias, idiomas, modo, rotuloPedido } = Astro.props;
---

<div class="familias">
  {
    familias.map((familia) => (
      <section class="familia revela" aria-labelledby={`familia-${familia.id}`} data-grupo={familia.id}>
        <h3 id={`familia-${familia.id}`} class="familia__nome">
          <span class="grifo"><Texto de={familia.nome} /></span>
        </h3>
        <p class="familia__descricao">
          <Texto de={familia.descricao} />
        </p>
        <ul class="familia__lista" role="list">
          {idiomas
            .filter((idioma) => idioma.familia === familia.id)
            .map((idioma) => (
              <li id={modo === 'pedido' ? idioma.slug : undefined} class="familia__item">
                {modo === 'links' ? (
                  <a class="idioma" href={`/curso-de-idiomas/#${idioma.slug}`}>
                    <span class="idioma__saudacao" lang={idioma.lang} dir={idioma.dir}>
                      {idioma.saudacao}
                    </span>{' '}
                    <span class="idioma__nome">{idioma.nome}</span>
                  </a>
                ) : (
                  <>
                    <button {...atributosDoContato({ servico: 'idiomas', idioma: idioma.slug })} class="idioma">
                      <span class="idioma__saudacao" lang={idioma.lang} dir={idioma.dir}>
                        {idioma.saudacao}
                      </span>{' '}
                      <span class="idioma__nome">{idioma.nome}</span>{' '}
                      <span class="visualmente-oculto">{rotuloPedido}</span>
                    </button>
                    <noscript>
                      <p class="idioma">
                        <span class="idioma__saudacao" lang={idioma.lang} dir={idioma.dir}>
                          {idioma.saudacao}
                        </span>{' '}
                        <span class="idioma__nome">{idioma.nome}</span>
                      </p>
                    </noscript>
                  </>
                )}
              </li>
            ))}
        </ul>
      </section>
    ))
  }
</div>

<style>
  .familias {
    display: grid;
    gap: var(--e-7);
  }

  .familia {
    display: grid;
    gap: var(--e-2);
    align-content: start;
  }

  .familia__nome {
    font-size: var(--t-3);
  }

  .familia__descricao {
    color: var(--navy-2);
  }

  .familia__lista {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr));
    gap: var(--e-2) var(--e-4);
    margin-block-start: var(--e-4);
    padding: 0;
    list-style: none;
  }

  /* inline-block, não flex: no flex, o espaço entre a saudação e o nome some do nome acessível. */
  .idioma {
    display: inline-block;
    inline-size: 100%;
    padding-block: var(--e-3);
    border-block-start: 1px solid var(--linha);
    text-decoration: none;
  }

  /* O botão precisa perder a aparência de botão: aqui ele é a própria linha da lista.
     A meia-pílula no canto é o que diz que a linha faz alguma coisa quando tocada. */
  button.idioma {
    position: relative;
    padding-inline-end: var(--e-5);
    border-inline: 0;
    border-block-end: 0;
    background-color: transparent;
    text-align: start;
  }

  button.idioma::after {
    content: '';
    position: absolute;
    inset-block-start: var(--e-4);
    inset-inline-end: 0;
    inline-size: 0.4375rem;
    block-size: 0.875rem;
    border-radius: 0 var(--raio-pilula) var(--raio-pilula) 0;
    background-color: var(--menta);
  }

  .idioma__saudacao {
    display: block;
    font-family: var(--fonte-titulo);
    font-size: var(--t-3);
    font-weight: 600;
    line-height: 1.3;
    text-align: left; /* o árabe, em RTL, alinharia pela direita e sairia da coluna */
  }

  .idioma__nome {
    display: block;
    color: var(--navy-2);
  }

  /* O sublinhado do hover e o fio do idioma de destino pegam a cor da família, a mesma do grifo do título,
     para o código de cor valer na lista inteira. */
  a.idioma:hover .idioma__saudacao,
  button.idioma:hover .idioma__saudacao {
    text-decoration-line: underline;
    text-decoration-color: var(--cor-grupo);
    text-decoration-thickness: var(--sublinhado-destaque);
    text-underline-offset: 0.18em;
  }

  .familia__item:target .idioma {
    border-block-start-color: var(--cor-grupo);
  }

  @media (min-width: 64rem) {
    .familias {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: var(--e-6);
    }

    .familia__lista {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
