---
// Os 14 idiomas por família, cada um com o olá na própria língua (e o lang certo, para a letra certa).
// Na home, cada idioma é um link para a página de cursos; lá, cada idioma é uma âncora com o próprio id.
import Texto from './Texto.astro';

interface Familia {
  id: string;
  nome: string;
  descricao: string;
}

interface Idioma {
  slug: string;
  nome: string;
  saudacao: string;
  lang: string;
  dir?: 'rtl';
  familia: string;
}

interface Props {
  familias: Familia[];
  idiomas: Idioma[];
  modo: 'links' | 'ancoras';
}

const { familias, idiomas, modo } = Astro.props;
---

<div class="familias">
  {
    familias.map((familia) => (
      <section class="familia revela" aria-labelledby={`familia-${familia.id}`}>
        <h3 id={`familia-${familia.id}`} class="familia__nome">
          <Texto de={familia.nome} />
        </h3>
        <p class="familia__descricao">
          <Texto de={familia.descricao} />
        </p>
        <ul class="familia__lista" role="list">
          {idiomas
            .filter((idioma) => idioma.familia === familia.id)
            .map((idioma) => (
              <li id={modo === 'ancoras' ? idioma.slug : undefined} class="familia__item">
                {modo === 'links' ? (
                  <a class="idioma" href={`/curso-de-idiomas/#${idioma.slug}`}>
                    <span class="idioma__saudacao" lang={idioma.lang} dir={idioma.dir}>
                      {idioma.saudacao}
                    </span>{' '}
                    <span class="idioma__nome">{idioma.nome}</span>
                  </a>
                ) : (
                  <p class="idioma">
                    <span class="idioma__saudacao" lang={idioma.lang} dir={idioma.dir}>
                      {idioma.saudacao}
                    </span>{' '}
                    <span class="idioma__nome">{idioma.nome}</span>
                  </p>
                )}
              </li>
            ))}
        </ul>
      </section>
    ))
  }
</div>

<style>
  .familias {
    display: grid;
    gap: var(--e-7);
  }

  .familia {
    display: grid;
    gap: var(--e-2);
    align-content: start;
  }

  .familia__nome {
    font-size: var(--t-3);
  }

  .familia__descricao {
    color: var(--navy-2);
  }

  .familia__lista {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr));
    gap: var(--e-2) var(--e-4);
    margin-block-start: var(--e-4);
    padding: 0;
    list-style: none;
  }

  /* inline-block, não flex: no flex, o espaço entre a saudação e o nome some do nome acessível. */
  .idioma {
    display: inline-block;
    inline-size: 100%;
    padding-block: var(--e-3);
    border-block-start: 1px solid var(--linha);
    text-decoration: none;
  }

  .idioma__saudacao {
    display: block;
    font-family: var(--fonte-titulo);
    font-size: var(--t-3);
    font-weight: 600;
    line-height: 1.3;
    text-align: left; /* o árabe, em RTL, alinharia pela direita e sairia da coluna */
  }

  .idioma__nome {
    display: block;
    color: var(--navy-2);
  }

  a.idioma:hover .idioma__saudacao {
    text-decoration-line: underline;
    text-decoration-color: var(--magenta);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.18em;
  }

  .familia__item:target .idioma {
    border-block-start-color: var(--magenta);
  }

  @media (min-width: 64rem) {
    .familias {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: var(--e-6);
    }

    .familia__lista {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
