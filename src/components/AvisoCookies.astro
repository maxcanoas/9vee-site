---
// O aviso de cookies: "Aceitar" e "Recusar" com o mesmo peso, e "Preferências", que abre as duas categorias. Nasce
// escondido; o src/scripts/cookies.ts mostra o aviso enquanto não houver resposta da versão atual, e o botão
// "Preferências de cookies" do rodapé reabre. Sem JavaScript ele não aparece, e nada é medido: o GA4 depende do script.
// Vem antes do cabeçalho: enquanto ele está na tela, é a primeira parada do Tab. Não é modal, e não prende o foco.
import Texto from './Texto.astro';
import type { DadosDoSite } from '../lib/site';

interface Props {
  textos: DadosDoSite['cookies'];
  /** O ID do GA4 do modo. Sem ele (o preview), o aceite fica guardado, e nada é carregado. */
  ga4: string;
  /** No local, os eventos vão para o DebugView da propriedade de teste. */
  depurar?: boolean;
}

const { textos, ga4, depurar = false } = Astro.props;
const { categorias } = textos;
---

<section
  class="aviso-cookies"
  id="aviso-cookies"
  aria-label={textos.rotulo}
  data-aviso-cookies
  data-versao={textos.versao}
  data-ga4={ga4 || undefined}
  data-ga4-depurar={(ga4 && depurar) || undefined}
  hidden
>
  <div class="aviso-cookies__corpo">
    <p class="aviso-cookies__titulo">{textos.titulo}</p>
    <p class="aviso-cookies__texto"><Texto de={textos.texto} /></p>

    <fieldset class="aviso-cookies__categorias" id="aviso-cookies-categorias" hidden>
      <legend class="rotulo">{categorias.legenda}</legend>
      <label class="aviso-cookies__categoria">
        <input type="checkbox" checked disabled />
        <span>
          <span class="aviso-cookies__nome">{categorias.necessarios.nome}</span>
          <span class="aviso-cookies__explica">{categorias.necessarios.texto}</span>
        </span>
      </label>
      <label class="aviso-cookies__categoria">
        <input type="checkbox" name="cookies-estatistica" />
        <span>
          <span class="aviso-cookies__nome">{categorias.estatistica.nome}</span>
          <span class="aviso-cookies__explica">{categorias.estatistica.texto}</span>
        </span>
      </label>
    </fieldset>
  </div>

  <div class="aviso-cookies__acoes">
    <button type="button" class="botao botao--contorno" data-cookies="aceitar"><span>{textos.aceitar}</span></button>
    <button type="button" class="botao botao--contorno" data-cookies="recusar"><span>{textos.recusar}</span></button>
    <button
      type="button"
      class="aviso-cookies__mais"
      data-cookies="preferencias"
      aria-expanded="false"
      aria-controls="aviso-cookies-categorias"><span>{textos.preferencias}</span></button
    >
    <button type="button" class="botao" data-cookies="salvar" hidden><span>{textos.salvar}</span></button>
  </div>
</section>

<style>
  /* Um cartão no pé da tela, por cima da página: não empurra o conteúdo, então não mexe no CLS. No computador fica à
     esquerda, longe do atalho do WhatsApp; no celular, ocupa a largura, e o atalho sobe junto (BotaoWhatsApp). */
  .aviso-cookies {
    position: fixed;
    inset-inline: max(var(--e-3), env(safe-area-inset-left)) max(var(--e-3), env(safe-area-inset-right));
    inset-block-end: max(var(--e-3), env(safe-area-inset-bottom));
    z-index: var(--z-aviso);
    display: grid;
    gap: var(--e-3);
    max-block-size: calc(100dvh - 2 * var(--e-3));
    padding: var(--e-4);
    overflow-y: auto;
    border: 1px solid var(--linha);
    background-color: var(--branco);
    color: var(--navy);
    box-shadow: var(--sombra-flutuante);
  }

  .aviso-cookies[hidden] {
    display: none;
  }

  .aviso-cookies__corpo {
    display: grid;
    gap: var(--e-2);
  }

  .aviso-cookies__titulo {
    font-family: var(--fonte-titulo);
    font-size: var(--t-destaque);
    font-weight: 600;
    line-height: var(--altura-subtitulo);
  }

  .aviso-cookies__texto {
    color: var(--navy-2);
    font-size: var(--t-pequeno);
  }

  .aviso-cookies__categorias {
    display: grid;
    gap: var(--e-3);
    margin: var(--e-2) 0 0;
    padding: 0;
    border: 0;
  }

  .aviso-cookies__categorias[hidden] {
    display: none;
  }

  .aviso-cookies__categoria {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--e-3);
    align-items: start;
    font-size: var(--t-pequeno);
  }

  .aviso-cookies__categoria input {
    inline-size: 1.25rem;
    block-size: 1.25rem;
    margin-block-start: 0.15rem;
    accent-color: var(--navy);
  }

  .aviso-cookies__nome {
    display: block;
    font-weight: 700;
  }

  .aviso-cookies__explica {
    color: var(--navy-2);
  }

  .aviso-cookies__acoes {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--e-2) var(--e-3);
  }

  /* Aceitar e Recusar dividem a linha em partes iguais: o mesmo peso, e nenhum dos dois é o "certo". */
  .aviso-cookies__acoes .botao {
    flex: 1 1 8rem;
  }

  .aviso-cookies__acoes .botao[hidden] {
    display: none;
  }

  /* Preferências é a terceira via: texto sublinhado, com a área de toque inteira. */
  .aviso-cookies__mais {
    min-block-size: var(--alvo-minimo);
    padding-inline: 0;
    border: 0;
    background: none;
    color: var(--navy);
    font: inherit;
    font-size: var(--t-interface);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 0.2em;
    cursor: pointer;
  }

  .aviso-cookies__mais[hidden] {
    display: none;
  }

  @media (min-width: 48rem) {
    .aviso-cookies {
      gap: var(--e-4);
      padding: var(--e-5);
      inset-inline-end: auto;
      inline-size: min(34rem, calc(100% - 2 * var(--e-5)));
      inset-inline-start: max(var(--e-5), env(safe-area-inset-left));
      inset-block-end: max(var(--e-5), env(safe-area-inset-bottom));
    }
  }
</style>
