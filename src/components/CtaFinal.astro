---
// O fechamento repete o círculo da marca do topo da página.
import Texto from './Texto.astro';
import BotaoContato from './BotaoContato.astro';
import CirculoMarca from './CirculoMarca.astro';
import type { ServicoId } from '../lib/contato';
import type { TextosPorPublico } from '../lib/publico';

interface Props {
  titulo: string;
  texto: string;
  /** Na home e nas páginas de idioma, o rótulo do botão muda com o público. Na página de um serviço, ele é fixo. */
  cta?: TextosPorPublico;
  rotulo?: string;
  servico?: ServicoId;
  /** Na página de um idioma, o pedido abre com ele marcado. */
  idioma?: string;
  /** Na home, o círculo leva o logo no miolo. */
  logo?: boolean;
  /** As perguntas que o pedido da página faz, na ordem do formulário: a pessoa já chega sabendo o que responder. */
  itens?: { titulo: string; texto: string }[];
}

const { titulo, texto, cta, rotulo, servico, idioma, logo, itens } = Astro.props;
---

<section class="cta-final escuro" id="contato" aria-labelledby="cta-final-titulo">
  <div class="conteiner cta-final__grade">
    <div class="cta-final__circulo" aria-hidden="true">
      <CirculoMarca sizes="(min-width: 64rem) 16rem, (min-width: 27.5rem) 11rem, 40vw" logo={logo} />
    </div>
    <div class="cta-final__texto">
      <h2 id="cta-final-titulo"><Texto de={titulo} /></h2>
      <p class="cta-final__apoio texto-secundario"><Texto de={texto} /></p>
      {
        itens && (
          <ol class="cta-final__itens">
            {itens.map((item, i) => (
              <li class="cta-final__item">
                <span class="selo-numero cta-final__numero" aria-hidden="true">
                  {i + 1}
                </span>
                <h3 class="cta-final__item-titulo">
                  <Texto de={item.titulo} />
                </h3>
                <p class="cta-final__item-texto texto-secundario">
                  <Texto de={item.texto} />
                </p>
              </li>
            ))}
          </ol>
        )
      }
      <BotaoContato textos={cta} texto={rotulo} servico={servico} idioma={idioma} />
    </div>
  </div>
</section>

<style>
  .cta-final {
    padding-block: var(--secao);
  }

  .cta-final__grade {
    display: grid;
    gap: var(--e-6);
    align-items: center;
  }

  .cta-final__circulo {
    inline-size: min(40vw, 11rem);
  }

  .cta-final__texto {
    display: grid;
    gap: var(--e-5);
    justify-items: start;
  }

  .cta-final__apoio {
    max-inline-size: 46ch;
    font-size: var(--t-destaque);
    line-height: var(--altura-apoio);
  }

  .cta-final__itens {
    display: grid;
    gap: var(--e-4);
    padding: 0;
    list-style: none;
  }

  .cta-final__item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--e-1) var(--e-4);
    align-items: start;
  }

  /* O selo fica na altura da pergunta, e o texto corre embaixo dela, na mesma coluna. */
  .cta-final__numero {
    grid-row: span 2;
  }

  .cta-final__item-titulo {
    font-size: var(--t-destaque);
  }

  .cta-final__item-texto {
    max-inline-size: 46ch;
  }

  @media (min-width: 64rem) {
    .cta-final__grade {
      grid-template-columns: auto 1fr;
      column-gap: var(--e-8);
    }

    .cta-final__circulo {
      inline-size: 16rem;
    }
  }
</style>
