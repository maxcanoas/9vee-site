---
// O fechamento repete o círculo da marca do topo da página.
import Texto from './Texto.astro';
import BotaoContato from './BotaoContato.astro';
import CirculoMarca from './CirculoMarca.astro';
import type { ServicoId } from '../lib/contato';
import type { TextosPorPublico } from '../lib/publico';

interface Props {
  titulo: string;
  texto: string;
  /** Na home, o rótulo do botão muda com o público. Na página de um serviço, ele é fixo. */
  cta?: TextosPorPublico;
  rotulo?: string;
  servico?: ServicoId;
  /** Na home, o círculo leva o logo no miolo. */
  logo?: boolean;
}

const { titulo, texto, cta, rotulo, servico, logo } = Astro.props;
---

<section class="cta-final escuro" id="contato" aria-labelledby="cta-final-titulo">
  <div class="conteiner cta-final__grade">
    <div class="cta-final__circulo" aria-hidden="true">
      <CirculoMarca sizes="(min-width: 64rem) 16rem, (min-width: 27.5rem) 11rem, 40vw" logo={logo} />
    </div>
    <div class="cta-final__texto">
      <h2 id="cta-final-titulo"><Texto de={titulo} /></h2>
      <p class="texto-secundario"><Texto de={texto} /></p>
      <BotaoContato textos={cta} texto={rotulo} servico={servico} />
    </div>
  </div>
</section>

<style>
  .cta-final {
    padding-block: var(--secao);
  }

  .cta-final__grade {
    display: grid;
    gap: var(--e-6);
    align-items: center;
  }

  .cta-final__circulo {
    inline-size: min(40vw, 11rem);
  }

  .cta-final__texto {
    display: grid;
    gap: var(--e-5);
    justify-items: start;
  }

  .cta-final__texto p {
    max-inline-size: 46ch;
    font-size: var(--t-destaque);
    line-height: var(--altura-apoio);
  }

  @media (min-width: 64rem) {
    .cta-final__grade {
      grid-template-columns: auto 1fr;
      column-gap: var(--e-8);
    }

    .cta-final__circulo {
      inline-size: 16rem;
    }
  }
</style>
