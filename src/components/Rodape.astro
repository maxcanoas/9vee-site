---
import Logo from './Logo.astro';
import IconeSocial from './IconeSocial.astro';
import Texto from './Texto.astro';
import type { DadosDoSite } from '../lib/site';

interface Props {
  site: DadosDoSite;
}

const { marca, contato, redes, menu, rodape, cookies } = Astro.props.site;
// Os grupos do menu, cada um com os links que só o rodapé tem no fim.
const grupos = menu.grupos.map((grupo) => ({
  ...grupo,
  itens: [...grupo.itens, ...rodape.soNoRodape.filter((link) => link.grupo === grupo.id)],
}));
---

<footer class="rodape escuro">
  <div class="conteiner rodape__grade">
    <div class="rodape__marca">
      <a class="rodape__logo-link" href="/" aria-label={menu.inicio}>
        <Logo />
      </a>
      <p class="rodape__resumo"><Texto de={marca.resumo} /></p>
      <p class="texto-secundario"><Texto de={rodape.pronuncia} /></p>
    </div>

    <nav class="rodape__nav" aria-label={rodape.rotuloNavegacao}>
      {
        grupos.map((grupo) => (
          <div data-grupo={grupo.id}>
            <p class="rodape__rotulo" id={`rodape-${grupo.id}`}>
              <span class="grifo">{grupo.rotulo}</span>
            </p>
            <ul class="rodape__lista" role="list" aria-labelledby={`rodape-${grupo.id}`}>
              {grupo.itens.map((item) => (
                <li>
                  <a href={item.href}><Texto de={item.rotulo} /></a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </nav>

    <div class="rodape__contato">
      <p class="rodape__rotulo">{rodape.tituloContato}</p>
      <p class="texto-secundario"><Texto de={rodape.atendimento} /></p>
      <p>{rodape.rotuloWhatsapp} {contato.whatsappExibicao}</p>
      <p>
        <a href={`mailto:${contato.email}`}>{contato.email}</a>
      </p>
      {/* O nome e a cidade como estão no Perfil da Empresa no Google, e o link dele. */}
      <address class="rodape__endereco texto-secundario">
        {marca.nomeComercial}<br />
        {contato.endereco.cidade}, {contato.endereco.uf}
      </address>
      <p><Texto de={`[${rodape.rotuloPerfil}](${contato.perfilGoogle})`} /></p>
      <p><a href={menu.quemSomos.href}>{menu.quemSomos.rotulo}</a></p>
    </div>

    <div class="rodape__redes">
      <p class="rodape__rotulo" id="rodape-redes">{rodape.tituloRedes}</p>
      <ul class="rodape__icones" role="list" aria-labelledby="rodape-redes">
        {
          redes.map((rede) => (
            <li>
              <a
                class="rodape__icone"
                href={rede.url}
                target="_blank"
                rel="noopener"
                aria-label={rodape.rotuloRede.replace('{rede}', rede.nome)}
              >
                <IconeSocial icone={rede.icone} />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="conteiner rodape__base">
    <p class="rodape__frase"><Texto de={rodape.frase} /></p>
    <div class="rodape__assinatura">
      <p>{rodape.direitos}</p>
      {/* O crédito de quem desenvolveu o site, com o link para o site dele. */}
      <p><Texto de={rodape.credito} /></p>
    </div>
    <div class="rodape__legal">
      <a href={rodape.privacidade.href}>{rodape.privacidade.rotulo}</a>
      {/* Reabre o aviso de cookies, com as preferências abertas. Sem JavaScript, some: não há o que medir. */}
      <button type="button" class="rodape__preferencias" data-preferencias-cookies aria-controls="aviso-cookies">
        {cookies.rodape}
      </button>
    </div>
  </div>
</footer>

<style>
  .rodape {
    /* Embaixo, o espaço do atalho do WhatsApp: ele não cobre o fim do rodapé. */
    padding-block: var(--e-7) calc(var(--flutuante) + 2 * var(--e-4));
    background-color: var(--noite);
    view-transition-name: rodape;
  }

  .rodape__grade {
    display: grid;
    gap: var(--e-6);
  }

  .rodape__logo-link {
    display: inline-flex;
    min-block-size: var(--alvo-minimo);
    align-items: center;
    color: var(--papel);
  }

  /* O <svg> nasce dentro do SvgDoKit, fora do escopo deste componente: por isso o :global. */
  .rodape__logo-link :global(svg) {
    inline-size: auto;
    block-size: 2.5rem;
  }

  .rodape__marca {
    display: grid;
    gap: var(--e-3);
    align-content: start;
  }

  .rodape__resumo {
    max-inline-size: 26ch;
    font-family: var(--fonte-titulo);
    font-size: var(--t-destaque);
    font-weight: 600;
    line-height: var(--altura-subtitulo);
  }

  .rodape__nav {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: var(--e-6);
  }

  .rodape__rotulo {
    margin-block-end: var(--e-3);
    color: var(--menta);
    font-size: var(--t-pequeno);
    font-weight: 700;
  }

  /* Nos grupos de público, o rótulo tem grifo: o texto passa da menta para o papel, que dá 4,5:1 sobre as
     faixas do fundo escuro. */
  .rodape__nav .rodape__rotulo {
    color: var(--papel);
  }

  .rodape__lista {
    display: grid;
    gap: var(--e-1);
    padding: 0;
    list-style: none;
  }

  /* inline-block e não flex: no flex, o espaço antes de um <span> dentro do link some. */
  .rodape__lista a,
  .rodape__contato a,
  .rodape__base a {
    display: inline-block;
    padding-block: max(0px, (var(--alvo-minimo) - 1lh) / 2);
  }

  .rodape__contato {
    display: grid;
    gap: var(--e-2);
    align-content: start;
  }

  .rodape__contato .rodape__rotulo {
    margin-block-end: var(--e-1);
  }

  .rodape__endereco {
    font-style: normal;
  }

  .rodape__icones {
    display: flex;
    flex-wrap: wrap;
    padding: 0;
    list-style: none;
  }

  .rodape__icone {
    display: grid;
    place-items: center;
    inline-size: var(--alvo-minimo);
    block-size: var(--alvo-minimo);
    border-radius: var(--raio-pilula);
    color: var(--papel);
    transition-property: background-color, color;
    transition-duration: var(--dur-rapida);
  }

  .rodape__icone:hover {
    background-color: var(--menta);
    color: var(--navy);
  }

  .rodape__icone :global(svg) {
    inline-size: 1.375rem;
    block-size: 1.375rem;
  }

  .rodape__base {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--e-3);
    margin-block-start: var(--e-7);
    padding-block-start: var(--e-4);
    border-block-start: 1px solid var(--linha-escura);
    color: var(--sobre-escuro);
    font-size: var(--t-pequeno);
  }

  /* Os direitos e o crédito, juntos à esquerda; a política e as preferências, à direita. */
  .rodape__assinatura,
  .rodape__legal {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 var(--e-5);
  }

  /* O botão de preferências tem a cara do link da política, ao lado dele. */
  .rodape__preferencias {
    min-block-size: var(--alvo-minimo);
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-decoration: underline;
    text-underline-offset: 0.2em;
    cursor: pointer;
  }

  /* A frase que fecha o site ocupa a linha inteira, acima dos direitos e da política. */
  .rodape__frase {
    flex-basis: 100%;
    margin-block: var(--e-3);
    color: var(--papel);
    font-family: var(--fonte-titulo);
    font-size: var(--t-3);
    font-weight: 600;
    line-height: var(--altura-subtitulo);
  }

  @media (min-width: 64rem) {
    .rodape__grade {
      grid-template-columns: 1.3fr 2fr 1.2fr;
      grid-template-areas:
        'marca nav contato'
        'marca nav redes';
      column-gap: var(--e-7);
    }

    .rodape__marca {
      grid-area: marca;
    }

    .rodape__nav {
      grid-area: nav;
    }

    .rodape__contato {
      grid-area: contato;
    }

    .rodape__redes {
      grid-area: redes;
    }
  }
</style>
