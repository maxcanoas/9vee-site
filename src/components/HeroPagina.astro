---
// Hero das páginas internas: o texto primeiro, a imagem em arco ao lado e o círculo da marca atrás dela.
import Texto from './Texto.astro';
import BotaoContato from './BotaoContato.astro';
import ArcoComCirculo from './ArcoComCirculo.astro';
import Trilha from './Trilha.astro';
import type { ServicoId } from '../lib/contato';
import type { TextosPorPublico } from '../lib/publico';
import type { Imagem } from '../content.config';

interface Props {
  rotulo: string;
  h1: string;
  apoio: string;
  /** Rótulo fixo do botão. Na página que serve os dois públicos, use `textos` no lugar. */
  cta?: string;
  textos?: TextosPorPublico;
  imagem: Imagem;
  servico?: ServicoId;
  /** Só nas páginas parciais: o aviso de que a página ainda não está completa. */
  etiqueta?: string;
}

const { rotulo, h1, apoio, cta, textos, imagem, servico, etiqueta } = Astro.props;
---

<section class="hero-pagina escuro" aria-labelledby="hero-titulo">
  <div class="conteiner hero-pagina__grade">
    <div class="hero-pagina__texto">
      <Trilha />
      {etiqueta && <p class="hero-pagina__etiqueta">{etiqueta}</p>}
      <p class="hero-pagina__rotulo"><Texto de={rotulo} /></p>
      <h1 id="hero-titulo"><Texto de={h1} /></h1>
      <p class="hero-pagina__apoio"><Texto de={apoio} /></p>
      <BotaoContato texto={cta} textos={textos} servico={servico} />
    </div>

    <ArcoComCirculo imagem={imagem} />
  </div>
</section>

<style>
  /* A trilha ocupa o alto do hero. Por isso o respiro de cima é o mesmo no celular e no computador: com o
     respiro de seção, o botão sairia da primeira tela em 1280 x 800. */
  .hero-pagina {
    padding-block: var(--e-7) var(--secao);
  }

  .hero-pagina__grade {
    display: grid;
    gap: var(--e-7);
    align-items: center;
  }

  .hero-pagina__texto {
    display: grid;
    gap: var(--e-5);
    justify-items: start;
  }

  .hero-pagina__rotulo {
    color: var(--menta);
    font-size: var(--t-pequeno);
    font-weight: 700;
  }

  /* Tracejado: o mesmo contorno das pendências, para ler como aviso de obra. */
  .hero-pagina__etiqueta {
    padding-block: var(--e-1);
    padding-inline: var(--e-3);
    border: 1px dashed var(--sobre-escuro);
    border-radius: var(--raio-pilula);
    color: var(--sobre-escuro);
    font-size: var(--t-rotulo);
    font-weight: 700;
  }

  .hero-pagina__texto h1 {
    max-inline-size: 16ch;
  }

  .hero-pagina__apoio {
    max-inline-size: 46ch;
    color: var(--sobre-escuro);
    font-size: var(--t-destaque);
    line-height: var(--altura-apoio);
  }

  @media (min-width: 64rem) {
    .hero-pagina__grade {
      grid-template-columns: 1.15fr 0.85fr;
      column-gap: var(--e-8);
    }
  }
</style>
