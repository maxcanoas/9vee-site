---
// Hero das páginas internas: o texto primeiro, a imagem em arco ao lado e o círculo da marca atrás dela.
import Texto from './Texto.astro';
import BotaoContato from './BotaoContato.astro';
import ArcoComCirculo from './ArcoComCirculo.astro';
import Trilha from './Trilha.astro';
import AvisoNaoPublicada from './AvisoNaoPublicada.astro';
import type { ServicoId } from '../lib/contato';
import type { TextosPorPublico } from '../lib/publico';
import type { Imagem } from '../content.config';

interface Props {
  rotulo: string;
  h1: string;
  apoio: string;
  /** Rótulo fixo do botão. Na página que serve os dois públicos, use `textos` no lugar. */
  cta?: string;
  textos?: TextosPorPublico;
  imagem: Imagem;
  servico?: ServicoId;
  /** A linha logo abaixo do botão, na página que promete um prazo de resposta. */
  nota?: string;
  /** O aviso da página de cidade que ainda não vai para o site. */
  etiqueta?: string;
}

const { rotulo, h1, apoio, cta, textos, imagem, servico, nota, etiqueta } = Astro.props;
---

<section class="hero-pagina escuro" aria-labelledby="hero-titulo">
  <div class="conteiner hero-pagina__grade">
    <div class="hero-pagina__texto">
      <Trilha />
      {etiqueta && <AvisoNaoPublicada texto={etiqueta} />}
      <p class="hero-pagina__rotulo"><Texto de={rotulo} /></p>
      <h1 id="hero-titulo"><Texto de={h1} /></h1>
      <p class="hero-pagina__apoio"><Texto de={apoio} /></p>
      <BotaoContato texto={cta} textos={textos} servico={servico} nota={nota} />
    </div>

    <ArcoComCirculo imagem={imagem} />
  </div>
</section>

<style>
  /* A trilha ocupa o alto do hero. Por isso o respiro de cima é o mesmo no celular e no computador: com o
     respiro de seção, o botão sairia da primeira tela em 1280 x 800. */
  .hero-pagina {
    padding-block: var(--e-7) var(--secao);
  }

  .hero-pagina__grade {
    display: grid;
    gap: var(--e-7);
    align-items: center;
  }

  .hero-pagina__texto {
    display: grid;
    gap: var(--e-5);
    justify-items: start;
  }

  .hero-pagina__rotulo {
    color: var(--menta);
    font-size: var(--t-pequeno);
    font-weight: 700;
  }

  .hero-pagina__texto h1 {
    max-inline-size: 16ch;
  }

  .hero-pagina__apoio {
    max-inline-size: 46ch;
    color: var(--sobre-escuro);
    font-size: var(--t-destaque);
    line-height: var(--altura-apoio);
  }

  @media (min-width: 64rem) {
    .hero-pagina__grade {
      grid-template-columns: 1.15fr 0.85fr;
      column-gap: var(--e-8);
    }
  }

  /* Notebook de tela baixa (1366 x 768, a mais comum, deixa uns 657 px de página): com o respiro e os espaços de
     sempre, o botão do LMS ficava abaixo da primeira tela. */
  @media (min-width: 64rem) and (max-height: 48rem) {
    .hero-pagina {
      padding-block-start: var(--e-6);
    }

    .hero-pagina__texto {
      gap: var(--e-4);
    }
  }
</style>
