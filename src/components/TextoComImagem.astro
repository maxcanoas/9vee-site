---
// Texto corrido ao lado de uma imagem em arco: o que é o serviço, como ele funciona. O primeiro parágrafo abre
// maior, como apoio. No celular o texto vem antes da imagem.
import ComImagem from './ComImagem.astro';
import Texto from './Texto.astro';
import type { Imagem } from '../content.config';

interface Props {
  id: string;
  titulo: string;
  paragrafos: string[];
  imagem: Imagem;
}

const { id, titulo, paragrafos, imagem } = Astro.props;
const [abertura, ...demais] = paragrafos;
---

<ComImagem {id} tituloId={`${id}-titulo`} {imagem}>
  <div class="texto-imagem">
    <h2 id={`${id}-titulo`} class="revela"><Texto de={titulo} /></h2>
    <p class="texto-imagem__abertura"><Texto de={abertura} /></p>
    {
      demais.map((paragrafo) => (
        <p class="texto-imagem__paragrafo texto-secundario">
          <Texto de={paragrafo} />
        </p>
      ))
    }
  </div>
</ComImagem>

<style>
  .texto-imagem {
    display: grid;
    gap: var(--e-4);
  }

  .texto-imagem__abertura {
    max-inline-size: 44ch;
    font-size: var(--t-destaque);
    line-height: var(--altura-apoio);
  }

  .texto-imagem__paragrafo {
    max-inline-size: 58ch;
  }
</style>
