---
// Os princípios da empresa lado a lado: o nome de cada um com o grifo na cor dele, a frase que o define e os itens
// que o detalham. O id do princípio dá a cor, pelo mapa [data-grupo] do base.css. No celular fica um embaixo do outro.
import CabecaDeSecao from './CabecaDeSecao.astro';
import Texto from './Texto.astro';

interface Props {
  id: string;
  titulo: string;
  apoio: string;
  itens: { id: string; nome: string; texto: string; itens: { titulo: string; texto: string }[] }[];
}

const { id, titulo, apoio, itens } = Astro.props;
---

<section class="principios" id={id} aria-labelledby={`${id}-titulo`}>
  <div class="conteiner principios__grade">
    <CabecaDeSecao {id} {titulo} {apoio} />

    <ul class="principios__lista" role="list">
      {
        itens.map((principio) => (
          <li class="principio" data-grupo={principio.id}>
            <h3 class="principio__nome">
              <span class="grifo">
                <Texto de={principio.nome} />
              </span>
            </h3>
            <p class="principio__texto">
              <Texto de={principio.texto} />
            </p>
            <ul class="principio__itens" role="list">
              {principio.itens.map((item) => (
                <li class="principio__item">
                  <h4 class="principio__item-titulo">
                    <Texto de={item.titulo} />
                  </h4>
                  <p class="principio__item-texto">
                    <Texto de={item.texto} />
                  </p>
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .principios {
    padding-block: var(--secao);
  }

  .principios__grade {
    display: grid;
    gap: var(--e-6);
  }

  .principios__lista {
    display: grid;
    gap: var(--e-6);
    padding: 0;
    list-style: none;
  }

  .principio {
    display: grid;
    gap: var(--e-3);
    align-content: start;
    padding-block-start: var(--e-4);
    border-block-start: 1px solid var(--navy);
  }

  .principio__nome {
    font-size: var(--t-3);
  }

  .principio__texto {
    max-inline-size: 36ch;
    font-size: var(--t-destaque);
    line-height: var(--altura-apoio);
  }

  .principio__itens {
    display: grid;
    padding: 0;
    margin-block-start: var(--e-3);
    list-style: none;
  }

  .principio__item {
    padding-block: var(--e-4);
    border-block-start: 1px solid var(--linha);
  }

  .principio__item-titulo {
    font-size: var(--t-interface);
    line-height: var(--altura-subtitulo);
    letter-spacing: 0;
  }

  .principio__item-texto {
    max-inline-size: 40ch;
    margin-block-start: var(--e-1);
    color: var(--navy-2);
  }

  /* Lado a lado, o nome, a frase e os itens de cada princípio começam na mesma altura dos vizinhos. */
  @media (min-width: 64rem) {
    .principios__lista {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--e-3) var(--e-6);
    }

    .principio {
      grid-row: span 3;
      grid-template-rows: subgrid;
    }

    .principio__itens {
      margin-block-start: 0;
    }
  }
</style>
