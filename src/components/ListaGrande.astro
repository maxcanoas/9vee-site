---
// Uma lista de poucos itens em tipo grande, um por linha: o nome de um lado e o que ele cobre do outro. O título da
// seção é só o rótulo da lista: quem aparece são os nomes.
import Texto from './Texto.astro';

interface Props {
  id: string;
  titulo: string;
  itens: { nome: string; texto: string }[];
}

const { id, titulo, itens } = Astro.props;
---

<section class="lista-grande" id={id} aria-labelledby={`${id}-titulo`}>
  <div class="conteiner lista-grande__grade">
    <h2 id={`${id}-titulo`} class="rotulo"><Texto de={titulo} /></h2>

    <ul class="lista-grande__itens" role="list">
      {
        itens.map((item) => (
          <li class="lista-grande__item">
            <h3 class="lista-grande__nome">
              <Texto de={item.nome} />
            </h3>
            <p class="lista-grande__texto">
              <Texto de={item.texto} />
            </p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .lista-grande {
    padding-block: var(--secao);
  }

  .lista-grande__grade {
    display: grid;
    gap: var(--e-4);
  }

  .lista-grande__itens {
    display: grid;
    padding: 0;
    border-block-end: 1px solid var(--navy);
    list-style: none;
  }

  .lista-grande__item {
    display: grid;
    gap: var(--e-3);
    padding-block: var(--e-5);
    border-block-start: 1px solid var(--navy);
  }

  .lista-grande__nome {
    font-size: var(--t-2);
    line-height: var(--altura-titulo);
    letter-spacing: var(--rastreio-titulo);
  }

  .lista-grande__texto {
    max-inline-size: 40ch;
    font-size: var(--t-destaque);
    line-height: var(--altura-apoio);
  }

  /* Lado a lado, o texto começa na linha de base da primeira linha do nome. */
  @media (min-width: 48rem) {
    .lista-grande__item {
      grid-template-columns: 1fr 1fr;
      column-gap: var(--e-6);
      align-items: first baseline;
      padding-block: var(--e-6);
    }
  }

  @media (min-width: 64rem) {
    .lista-grande__item {
      column-gap: var(--e-8);
    }
  }
</style>
