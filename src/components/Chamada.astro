---
// A chamada do meio da página: a pergunta, o que a 9vee leva e o botão do pedido. É uma faixa mais baixa que uma
// seção, para ler como a virada entre duas partes da página, e não como mais uma seção.
import Texto from './Texto.astro';
import BotaoContato from './BotaoContato.astro';
import type { ServicoId } from '../lib/contato';

interface Props {
  id: string;
  titulo: string;
  texto: string;
  pontos: string[];
  cta: string;
  servico?: ServicoId;
}

const { id, titulo, texto, pontos, cta, servico } = Astro.props;
---

<section class="chamada" id={id} aria-labelledby={`${id}-titulo`}>
  <div class="conteiner chamada__grade">
    <h2 id={`${id}-titulo`} class="chamada__titulo revela"><Texto de={titulo} /></h2>

    <div class="chamada__corpo">
      <p class="chamada__texto"><Texto de={texto} /></p>
      <ul class="chamada__pontos" role="list">
        {
          pontos.map((ponto) => (
            <li class="chamada__ponto">
              <Texto de={ponto} />
            </li>
          ))
        }
      </ul>
      <BotaoContato texto={cta} servico={servico} />
    </div>
  </div>
</section>

<style>
  .chamada {
    padding-block: var(--e-7);
    border-block-end: 1px solid var(--linha);
  }

  .chamada__grade {
    display: grid;
    gap: var(--e-5);
  }

  .chamada__titulo {
    max-inline-size: 18ch;
  }

  .chamada__corpo {
    display: grid;
    gap: var(--e-5);
    justify-items: start;
  }

  .chamada__texto {
    max-inline-size: 40ch;
    color: var(--navy-2);
    font-size: var(--t-destaque);
    line-height: var(--altura-apoio);
  }

  .chamada__pontos {
    display: grid;
    gap: var(--e-2);
    padding: 0;
    list-style: none;
  }

  .chamada__ponto {
    position: relative;
    padding-inline-start: var(--e-5);
    font-family: var(--fonte-titulo);
    font-size: var(--t-destaque);
    font-weight: 600;
    line-height: var(--altura-subtitulo);
  }

  /* Marcador: a meia-pílula da marca, como nos pontos das seções escuras. */
  .chamada__ponto::before {
    content: '';
    position: absolute;
    inset-block-start: 0.15em;
    inset-inline-start: 0;
    inline-size: 0.5rem;
    block-size: 1rem;
    border-radius: var(--raio-pilula) 0 0 var(--raio-pilula);
    background-color: var(--menta);
  }

  @media (min-width: 64rem) {
    .chamada__grade {
      grid-template-columns: 1fr 1fr;
      column-gap: var(--e-8);
      align-items: center;
    }
  }
</style>
