---
// Atalho para o WhatsApp em todas as páginas, com a mensagem da página e do público.
// Sem JS, vale a mensagem neutra; com JS, o href troca quando a pessoa escolhe o público.
import IconeWhatsApp from './IconeWhatsApp.astro';
import { linkWhatsApp, mensagemFlutuante } from '../lib/contato';
import { AVISO_NOVA_ABA } from '../lib/texto';
import type { DadosDoSite, PaginaId } from '../lib/site';

interface Props {
  site: DadosDoSite;
  pagina: PaginaId;
}

const { site, pagina } = Astro.props;
const { nome, assunto } = site.paginas[pagina];
const link = (publico: keyof typeof assunto) =>
  linkWhatsApp(site.contato.whatsapp, mensagemFlutuante(nome, assunto[publico], site.drawer.mensagens));
---

<a
  class="whatsapp-flutuante"
  href={link('neutro')}
  target="_blank"
  rel="noopener"
  data-whatsapp-flutuante
  data-href-empresa={link('empresa')}
  data-href-voce={link('voce')}
>
  <IconeWhatsApp />
  <span class="visualmente-oculto">{site.drawer.botaoFlutuante}{AVISO_NOVA_ABA}</span>
</a>

<style>
  .whatsapp-flutuante {
    position: fixed;
    inset-inline-end: max(var(--e-4), env(safe-area-inset-right));
    inset-block-end: max(var(--e-4), env(safe-area-inset-bottom));
    z-index: var(--z-flutuante);
    display: grid;
    place-items: center;
    inline-size: var(--flutuante);
    block-size: var(--flutuante);
    border-radius: var(--raio-pilula);
    background-color: var(--menta);
    color: var(--navy);
    /* Sombra: o botão passa por cima de toda seção, inclusive das mentas e das imagens, e precisa se descolar delas. */
    box-shadow: var(--sombra-flutuante);
    transition-property: background-color;
    transition-duration: var(--dur-rapida);
  }

  .whatsapp-flutuante:hover {
    background-color: var(--menta-forte);
  }

  .whatsapp-flutuante :global(svg) {
    inline-size: 1.75rem;
    block-size: 1.75rem;
  }

  /* No celular, sai de cena enquanto a pessoa desce a página e volta quando ela sobe. */
  .whatsapp-flutuante[data-recolhido]:not(:focus-visible) {
    transform: translateY(calc(100% + var(--e-4) + env(safe-area-inset-bottom)));
  }

  /* Com o drawer ou o menu do celular abertos, o atalho some: o véu não pode deixá-lo por cima. */
  :global(html:has(.drawer[open])) .whatsapp-flutuante {
    visibility: hidden;
  }

  :global(html:has(#menu-movel:popover-open)) .whatsapp-flutuante {
    visibility: hidden;
  }

  @media (min-width: 48rem) {
    .whatsapp-flutuante[data-recolhido]:not(:focus-visible) {
      transform: none;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .whatsapp-flutuante {
      transition-property: background-color, transform;
      transition-duration: var(--dur-rapida), var(--dur-media);
      transition-timing-function: ease, var(--curva);
    }
  }
</style>
