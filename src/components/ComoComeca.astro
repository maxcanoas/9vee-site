---
// Os três passos até a primeira aula, com a imagem ao lado.
import Figura from './Figura.astro';
import Texto from './Texto.astro';

interface Props {
  titulo: string;
  apoio: string;
  etapas: { titulo: string; texto: string }[];
  imagem: { id: string; arquivo: string; alt: string };
}

const { titulo, apoio, etapas, imagem } = Astro.props;
---

<section class="comeca" id="como-comeca" aria-labelledby="comeca-titulo">
  <div class="conteiner comeca__grade">
    <div class="comeca__visual">
      <Figura
        {...imagem}
        proporcao="4/5"
        forma="arco"
        sizes="(min-width: 64rem) 22rem, 62vw"
        larguras={[400, 640, 800]}
      />
    </div>

    <div class="comeca__texto">
      <h2 id="comeca-titulo" class="revela"><Texto de={titulo} /></h2>
      <p class="comeca__apoio"><Texto de={apoio} /></p>

      <ol class="comeca__etapas">
        {
          etapas.map((etapa, i) => (
            <li class="passo">
              <span class="passo__numero" aria-hidden="true">
                {i + 1}
              </span>
              <h3 class="passo__titulo">
                <Texto de={etapa.titulo} />
              </h3>
              <p class="passo__texto">
                <Texto de={etapa.texto} />
              </p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .comeca {
    padding-block: var(--secao);
  }

  .comeca__grade {
    display: grid;
    gap: var(--e-6);
    align-items: center;
  }

  .comeca__visual {
    justify-self: center;
    inline-size: min(62vw, 20rem);
  }

  .comeca__apoio {
    max-inline-size: 44ch;
    margin-block-start: var(--e-4);
    color: var(--navy-2);
    font-size: var(--t-destaque);
    line-height: 1.45;
  }

  .comeca__etapas {
    display: grid;
    gap: var(--e-5);
    margin-block-start: var(--e-6);
    padding: 0;
    list-style: none;
  }

  .passo {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--e-1) var(--e-4);
    align-items: center;
  }

  .passo__numero {
    display: grid;
    grid-row: span 2;
    place-items: center;
    inline-size: 2rem;
    block-size: 2rem;
    border-radius: var(--raio-pilula);
    background-color: var(--menta);
    color: var(--navy);
    font-family: var(--fonte-titulo);
    font-size: var(--t-rotulo);
    font-weight: 600;
    line-height: 1;
  }

  .passo__titulo {
    align-self: end;
    font-size: var(--t-destaque);
  }

  .passo__texto {
    align-self: start;
    max-inline-size: 44ch;
    color: var(--navy-2);
  }

  @media (min-width: 64rem) {
    .comeca__grade {
      grid-template-columns: 0.8fr 1.2fr;
      column-gap: var(--e-8);
    }

    .comeca__visual {
      justify-self: start;
      inline-size: min(100%, 22rem);
    }
  }
</style>
