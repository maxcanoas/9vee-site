---
// Perguntas em <details> nativo: abre e fecha sem JS, pelo teclado e pelo leitor de tela.
import Texto from './Texto.astro';

interface Props {
  titulo: string;
  itens: { pergunta: string; resposta: string }[];
  id?: string;
}

const { titulo, itens, id = 'perguntas' } = Astro.props;
---

<section class="faq" id={id} aria-labelledby={`${id}-titulo`}>
  <div class="conteiner faq__grade">
    <h2 id={`${id}-titulo`} class="faq__titulo revela"><Texto de={titulo} /></h2>
    <div class="faq__lista">
      {
        itens.map((item) => (
          <details class="faq__item">
            <summary class="faq__pergunta">
              <h3 class="faq__texto-pergunta">
                <Texto de={item.pergunta} />
              </h3>
            </summary>
            <div class="faq__resposta">
              <p>
                <Texto de={item.resposta} />
              </p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq {
    padding-block: var(--secao);
  }

  .faq__grade {
    display: grid;
    gap: var(--e-6);
  }

  .faq__lista {
    border-block-end: 1px solid var(--linha);
  }

  .faq__item {
    border-block-start: 1px solid var(--linha);
  }

  .faq__pergunta {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: var(--e-4);
    min-block-size: var(--alvo-minimo);
    padding-block: var(--e-4);
    cursor: pointer;
    list-style: none;
  }

  .faq__pergunta::-webkit-details-marker {
    display: none;
  }

  .faq__texto-pergunta {
    font-size: var(--t-destaque);
    line-height: var(--altura-subtitulo);
    letter-spacing: 0;
  }

  /* Indicador: o meio-círculo da marca, que gira quando a resposta abre. */
  .faq__pergunta::after {
    content: '';
    inline-size: 0.875rem;
    block-size: 0.4375rem;
    border-radius: 0 0 var(--raio-pilula) var(--raio-pilula);
    background-color: var(--magenta);
    transition-property: transform;
    transition-duration: var(--dur-media);
    transition-timing-function: var(--curva);
  }

  .faq__item[open] .faq__pergunta::after {
    transform: rotate(180deg);
  }

  .faq__resposta {
    padding-block-end: var(--e-5);
  }

  .faq__resposta p {
    max-inline-size: 62ch;
    color: var(--navy-2);
  }

  @media (min-width: 64rem) {
    .faq__grade {
      grid-template-columns: 0.8fr 1.2fr;
      column-gap: var(--e-8);
      align-items: start;
    }
  }
</style>
