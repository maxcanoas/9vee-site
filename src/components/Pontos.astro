---
// Bloco escuro de pontos: o que a empresa leva do treinamento, o que a 9vee faz pela equipe.
// A nota fecha a coluna do título, embaixo, com o botão de contato quando a seção pede um.
import CabecaDeSecao from './CabecaDeSecao.astro';
import Texto from './Texto.astro';
import BotaoContato from './BotaoContato.astro';
import type { ServicoId } from '../lib/contato';

interface Props {
  id: string;
  titulo: string;
  apoio: string;
  itens: { titulo: string; texto: string }[];
  nota: string;
  cta?: string;
  servico?: ServicoId;
}

const { id, titulo, apoio, itens, nota, cta, servico } = Astro.props;
---

<section class="pontos escuro" id={id} aria-labelledby={`${id}-titulo`}>
  <div class="conteiner pontos__grade">
    <CabecaDeSecao {id} {titulo} {apoio} class="pontos__cabeca" />

    <ul class="pontos__itens" role="list">
      {
        itens.map((item) => (
          <li class="ponto">
            <h3 class="ponto__titulo">
              <Texto de={item.titulo} />
            </h3>
            <p class="ponto__texto texto-secundario">
              <Texto de={item.texto} />
            </p>
          </li>
        ))
      }
    </ul>

    <div class="pontos__fecho">
      <p class="pontos__nota"><Texto de={nota} /></p>
      {cta && <BotaoContato texto={cta} servico={servico} />}
    </div>
  </div>
</section>

<style>
  .pontos {
    padding-block: var(--secao);
  }

  .pontos__grade {
    display: grid;
    gap: var(--e-6);
  }


  .pontos__itens {
    display: grid;
    gap: var(--e-5);
    padding: 0;
    list-style: none;
  }

  .ponto {
    position: relative;
    padding-inline-start: var(--e-5);
  }

  /* Marcador: a meia-pílula da marca, como nos pontos do destaque da home. */
  .ponto::before {
    content: '';
    position: absolute;
    inset-block-start: 0.35em;
    inset-inline-start: 0;
    inline-size: 0.5rem;
    block-size: 1rem;
    border-radius: var(--raio-pilula) 0 0 var(--raio-pilula);
    background-color: var(--menta);
  }

  .ponto__titulo {
    font-size: var(--t-destaque);
  }

  .ponto__texto {
    max-inline-size: 42ch;
    margin-block-start: var(--e-2);
  }

  .pontos__fecho {
    display: grid;
    gap: var(--e-5);
    justify-items: start;
  }

  .pontos__nota {
    max-inline-size: 62ch;
    padding: var(--e-5);
    border: 1px solid var(--linha-escura);
  }

  @media (min-width: 48rem) {
    .pontos__itens {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: var(--e-5);
    }
  }

  @media (min-width: 64rem) {
    .pontos__grade {
      grid-template-columns: 0.9fr 1.1fr;
      column-gap: var(--e-8);
    }

    .pontos__cabeca {
      grid-area: 1 / 1;
    }

    .pontos__itens {
      grid-area: 1 / 2 / span 2;
      grid-template-columns: 1fr;
      gap: var(--e-6);
    }

    /* A ressalva fecha a coluna do título, embaixo, e não sobra vazio. */
    .pontos__fecho {
      grid-area: 2 / 1;
      align-self: end;
    }
  }
</style>
