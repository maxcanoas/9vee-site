---
import Figura from './Figura.astro';
import Texto from './Texto.astro';
import EscolhaPublico from './EscolhaPublico.astro';
import BotaoContato from './BotaoContato.astro';

interface Imagem {
  id: string;
  arquivo: string;
  alt: string;
}

interface Props {
  h1: string;
  apoio: string;
  legendaPublico: string;
  opcoes: { empresa: string; voce: string };
  imagemFundo: Imagem;
  imagemFrente: Imagem;
  cta: { neutro: string; empresa: string; voce: string };
}

const { h1, apoio, legendaPublico, opcoes, imagemFundo, imagemFrente, cta } = Astro.props;
---

<section class="hero" aria-labelledby="hero-titulo">
  <div class="hero__fundo">
    <Figura {...imagemFundo} proporcao="16/9" prioridade sizes="100vw" />
  </div>
  <div class="hero__veu" aria-hidden="true"></div>

  <div class="conteiner hero__grade">
    <div class="hero__texto">
      <h1 id="hero-titulo"><Texto de={h1} /></h1>
      <p class="hero__apoio"><Texto de={apoio} /></p>
      <EscolhaPublico legenda={legendaPublico} opcoes={opcoes} />
      <BotaoContato textos={cta} class="hero__cta" />
    </div>

    <div class="hero__visual">
      <span class="hero__meia hero__meia--esquerda" aria-hidden="true"></span>
      <span class="hero__meia hero__meia--direita" aria-hidden="true"></span>
      <div class="hero__frente">
        <Figura
          {...imagemFrente}
          proporcao="4/5"
          forma="arco"
          recorte
          sizes="(min-width: 64rem) 26rem, 55vw"
          larguras={[400, 640, 800, 1040]}
        />
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: clip;
    isolation: isolate;
    background-color: var(--navy);
    color: var(--papel);
  }

  .hero__fundo {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  .hero__fundo :global(.figura) {
    block-size: 100%;
    aspect-ratio: auto;
  }

  /* Véu para o texto manter contraste sobre a foto do auditório, que ainda vai chegar do Gemini. */
  .hero__veu {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: linear-gradient(
      to top,
      color-mix(in oklab, var(--noite) 92%, transparent) 0%,
      color-mix(in oklab, var(--noite) 70%, transparent) 45%,
      color-mix(in oklab, var(--noite) 10%, transparent) 100%
    );
  }

  .hero__grade {
    display: grid;
    gap: var(--e-6);
    align-content: end;
    min-block-size: calc(100svh - var(--altura-cabecalho));
    padding-block: var(--e-5) var(--e-7);
  }

  .hero__texto {
    display: grid;
    gap: var(--e-5);
    justify-items: start;
    max-inline-size: 40rem;
  }

  .hero__texto h1 {
    max-inline-size: 12ch;
  }

  .hero__apoio {
    max-inline-size: 38ch;
    color: var(--sobre-escuro);
    font-size: var(--t-destaque);
    line-height: 1.45;
  }

  .hero__texto :global(.duas-metades) {
    inline-size: 100%;
  }

  /* No celular, o visual vem antes do texto na tela; no HTML, o H1 continua primeiro.
     Quadrado: o círculo ocupa o topo e o retrato, mais estreito, desce por dentro dele,
     deixando à vista o ponto em que as duas metades se encontram, acima da cabeça. */
  .hero__visual {
    position: relative;
    order: -1;
    justify-self: center;
    inline-size: min(60vw, 16rem);
    aspect-ratio: 1 / 1;
  }

  .hero__frente {
    position: absolute;
    z-index: 1;
    inset-block-start: 25%;
    inset-inline-start: 20%;
    inline-size: 60%;
  }

  /* Centralizado com margem automática: com inset de 50%, a etiqueta só teria meia largura e quebraria. */
  .hero__frente :global(.placeholder__id) {
    inset-inline: 0;
    inline-size: fit-content;
    max-inline-size: 94%;
    margin-inline: auto;
    font-size: 0.6875rem;
    text-align: center;
  }

  /* Juntas, as metades formam um círculo maior que o retrato: uma auréola atrás da intérprete.
     Esse é o estado de base, que vale sem animação; com animação, elas começam afastadas. */
  .hero__meia {
    position: absolute;
    inset-block-start: 0;
    inline-size: 45%;
    aspect-ratio: 1 / 2;
  }

  .hero__meia--esquerda {
    inset-inline-end: calc(50% + 1.5px);
    border-radius: var(--raio-pilula) 0 0 var(--raio-pilula);
    background-color: var(--menta);
  }

  .hero__meia--direita {
    inset-inline-start: calc(50% + 1.5px);
    border-radius: 0 var(--raio-pilula) var(--raio-pilula) 0;
    background-color: var(--magenta);
  }

  @media (min-width: 64rem) {
    .hero__grade {
      grid-template-columns: 1.15fr 0.85fr;
      align-items: center;
      align-content: center;
      min-block-size: min(54rem, calc(100svh - var(--altura-cabecalho)));
      padding-block: var(--e-7);
    }

    .hero__visual {
      order: 0;
      inline-size: min(100%, 28rem);
    }

    .hero__veu {
      background-image: linear-gradient(
        to right,
        color-mix(in oklab, var(--noite) 90%, transparent) 0%,
        color-mix(in oklab, var(--noite) 55%, transparent) 55%,
        color-mix(in oklab, var(--noite) 15%, transparent) 100%
      );
    }
  }

  /* Parallax: o fundo desce mais devagar, a pessoa sobe e as duas metades se juntam num círculo. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: scroll()) {
      .hero__fundo,
      .hero__frente,
      .hero__meia {
        animation-duration: 1ms;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: scroll(root);
        animation-range: 0 70svh;
        will-change: transform;
      }

      .hero__fundo {
        animation-name: hero-fundo;
      }

      .hero__frente {
        animation-name: hero-frente;
      }

      .hero__meia--esquerda {
        animation-name: hero-meia-esquerda;
      }

      .hero__meia--direita {
        animation-name: hero-meia-direita;
      }
    }
  }

  @keyframes hero-fundo {
    from {
      transform: translateY(0) scale(1.06);
    }
    to {
      transform: translateY(14%) scale(1.06);
    }
  }

  @keyframes hero-frente {
    from {
      transform: translateY(0);
    }
    to {
      transform: translateY(-10%);
    }
  }

  @keyframes hero-meia-esquerda {
    from {
      transform: translateX(-34%);
    }
    to {
      transform: translateX(0);
    }
  }

  @keyframes hero-meia-direita {
    from {
      transform: translateX(34%);
    }
    to {
      transform: translateX(0);
    }
  }
</style>
