---
import Figura from './Figura.astro';
import Texto from './Texto.astro';
import TextoPorPublico from './TextoPorPublico.astro';
import EscolhaPublico from './EscolhaPublico.astro';
import BotaoContato from './BotaoContato.astro';
import CirculoMarca from './CirculoMarca.astro';
import { AVISO_NOVA_ABA } from '../lib/texto';
import type { TextosPorPublico } from '../lib/publico';
import type { Imagem } from '../content.config';

interface Props {
  h1: string;
  apoio: TextosPorPublico;
  legendaPublico: string;
  opcoes: { empresa: string; voce: string };
  imagemFundo: Imagem;
  imagemFrente: Imagem;
  imagemFrenteVoce: Imagem;
  cta: TextosPorPublico;
  /** O segundo botão, só para quem escolhe "Para você": a aula experimental, pelo WhatsApp. */
  experimental: { rotulo: string; href: string };
}

const { h1, apoio, legendaPublico, opcoes, imagemFundo, imagemFrente, imagemFrenteVoce, cta, experimental } = Astro.props;
// As duas pessoas da frente, a intérprete e quem estuda, saem do mesmo recorte.
const retrato = {
  proporcao: '4/5' as const,
  forma: 'arco' as const,
  recorte: true,
  sizes: '(min-width: 64rem) 26rem, 55vw',
  larguras: [400, 640, 800, 1040],
};
---

<section class="hero" aria-labelledby="hero-titulo">
  <div class="hero__fundo">
    <Figura {...imagemFundo} proporcao="16/9" prioridade sizes="100vw" />
  </div>
  <div class="hero__veu" aria-hidden="true"></div>

  <div class="conteiner hero__grade">
    <div class="hero__texto">
      <h1 id="hero-titulo"><Texto de={h1} /></h1>
      <p class="hero__apoio"><TextoPorPublico textos={apoio} /></p>
      <EscolhaPublico legenda={legendaPublico} opcoes={opcoes} />
      <div class="hero__botoes">
        <BotaoContato textos={cta} class="hero__cta" />
        <a
          class="botao botao--contorno hero__experimental"
          href={experimental.href}
          target="_blank"
          rel="noopener"
          data-whatsapp-experimental
        >
          <span>{experimental.rotulo}<span class="visualmente-oculto">{AVISO_NOVA_ABA}</span></span>
        </a>
      </div>
    </div>

    <div class="hero__visual">
      <div class="hero__circulo" aria-hidden="true">
        <CirculoMarca sizes="(min-width: 64rem) 25rem, (min-width: 27rem) 14.5rem, 54vw" primeiraDobra />
      </div>
      <div class="hero__frente hero__frente--padrao">
        <Figura {...imagemFrente} {...retrato} primeiraDobra />
      </div>
      {/* Escondida até a escolha "Para você": carrega com a página, depois do resto, para a troca não mostrar o arco vazio. */}
      <div class="hero__frente hero__frente--voce">
        <Figura {...imagemFrenteVoce} {...retrato} prioridadeBaixa />
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: clip;
    isolation: isolate;
    background-color: var(--navy);
    color: var(--papel);
  }

  .hero__fundo {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  .hero__fundo :global(.figura) {
    block-size: 100%;
    aspect-ratio: auto;
  }

  /* Véu para o texto manter contraste sobre a foto do auditório, que ainda vai chegar do Gemini. */
  .hero__veu {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: linear-gradient(
      to top,
      color-mix(in oklab, var(--noite) 92%, transparent) 0%,
      color-mix(in oklab, var(--noite) 70%, transparent) 45%,
      color-mix(in oklab, var(--noite) 10%, transparent) 100%
    );
  }

  .hero__grade {
    display: grid;
    gap: var(--e-6);
    align-content: end;
    min-block-size: calc(100svh - var(--altura-cabecalho));
    padding-block: var(--e-5) var(--e-7);
  }

  .hero__texto {
    display: grid;
    gap: var(--e-5);
    justify-items: start;
    max-inline-size: 40rem;
  }

  .hero__texto h1 {
    max-inline-size: 12ch;
  }

  .hero__apoio {
    max-inline-size: 38ch;
    color: var(--sobre-escuro);
    font-size: var(--t-destaque);
    line-height: var(--altura-apoio);
  }

  .hero__texto :global(.duas-metades) {
    inline-size: 100%;
  }

  /* No celular, o visual vem antes do texto na tela; no HTML, o H1 continua primeiro.
     Quadrado: o círculo ocupa o topo e o retrato, mais estreito, desce por dentro dele,
     deixando à vista o alto do círculo, acima da cabeça. */
  .hero__visual {
    position: relative;
    order: -1;
    justify-self: center;
    inline-size: min(60vw, 16rem);
    aspect-ratio: 1 / 1;
  }

  .hero__frente {
    position: absolute;
    z-index: 1;
    inset-block-start: 25%;
    inset-inline-start: 20%;
    inline-size: 60%;
  }

  .hero__botoes {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-3);
  }

  /* A aula experimental só aparece para quem escolhe "Para você", pelo mesmo data-publico da troca da foto. Sem escolha
     e para a empresa, o topo fica com um botão só. No fundo escuro, o texto e o contorno são claros, e o hover clareia
     o fundo, em vez da névoa. */
  .hero__experimental {
    display: none;
    color: var(--papel);
  }

  :global(:root[data-publico='voce']) .hero__experimental {
    display: inline-flex;
  }

  .hero__experimental:hover {
    background-color: color-mix(in oklab, var(--papel) 14%, transparent);
  }

  /* Quem escolhe "Para você" vê a aluna no lugar da intérprete. Sem escolha e para a empresa, fica a intérprete.
     A troca vale antes da primeira pintura, pelo data-publico que o <head> põe no <html>. */
  .hero__frente--voce,
  :global(:root[data-publico='voce']) .hero__frente--padrao {
    display: none;
  }

  :global(:root[data-publico='voce']) .hero__frente--voce {
    display: block;
  }

  /* Centralizado com margem automática: com inset de 50%, a etiqueta só teria meia largura e quebraria. */
  .hero__frente :global(.placeholder__id) {
    inset-inline: 0;
    inline-size: fit-content;
    max-inline-size: 94%;
    margin-inline: auto;
    font-size: var(--t-chip);
    text-align: center;
  }

  /* O círculo da marca, maior que o retrato: uma auréola atrás da intérprete. */
  .hero__circulo {
    position: absolute;
    inset-block-start: 0;
    inset-inline: 5%;
  }

  @media (min-width: 64rem) {
    .hero__grade {
      grid-template-columns: 1.15fr 0.85fr;
      align-items: center;
      align-content: center;
      min-block-size: min(54rem, calc(100svh - var(--altura-cabecalho)));
      padding-block: var(--e-7);
    }

    .hero__visual {
      order: 0;
      inline-size: min(100%, 28rem);
    }

    .hero__veu {
      background-image: linear-gradient(
        to right,
        color-mix(in oklab, var(--noite) 90%, transparent) 0%,
        color-mix(in oklab, var(--noite) 55%, transparent) 55%,
        color-mix(in oklab, var(--noite) 15%, transparent) 100%
      );
    }
  }

  /* Parallax: o fundo desce mais devagar, a pessoa sobe e o círculo gira devagar. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: scroll()) {
      .hero__fundo,
      .hero__frente,
      .hero__circulo {
        animation-duration: 1ms;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: scroll(root);
        animation-range: 0 70svh;
        will-change: transform;
      }

      .hero__fundo {
        animation-name: hero-fundo;
      }

      .hero__frente {
        animation-name: hero-frente;
      }

      .hero__circulo {
        animation-name: hero-circulo;
      }
    }
  }

  @keyframes hero-fundo {
    from {
      transform: translateY(0) scale(1.06);
    }
    to {
      transform: translateY(14%) scale(1.06);
    }
  }

  @keyframes hero-frente {
    from {
      transform: translateY(0);
    }
    to {
      transform: translateY(-10%);
    }
  }

  /* Uns 30 graus em 70% da tela rolada: dá para ver as cores andarem, sem virar roda. */
  @keyframes hero-circulo {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(-30deg);
    }
  }
</style>
