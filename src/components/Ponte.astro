---
// A ponte para outra página do site: um bloco escuro curto, com a frase que apresenta o assunto e o link para a
// página dele. Sem a página de destino no ar, o bloco sai sem link: link interno quebrado não passa nos testes.
import Texto from './Texto.astro';

interface Props {
  id: string;
  titulo: string;
  texto: string;
  link?: { rotulo: string; href: string };
}

const { id, titulo, texto, link } = Astro.props;
---

<section class="ponte escuro" id={id} aria-labelledby={`${id}-titulo`}>
  <div class="conteiner ponte__grade">
    <h2 id={`${id}-titulo`} class="ponte__titulo revela"><Texto de={titulo} /></h2>

    <div class="ponte__corpo">
      <p class="ponte__texto texto-secundario"><Texto de={texto} /></p>
      {
        link && (
          <a class="ponte__link" href={link.href}>
            <Texto de={link.rotulo} />
          </a>
        )
      }
    </div>
  </div>
</section>

<style>
  .ponte {
    padding-block: var(--secao);
  }

  .ponte__grade {
    display: grid;
    gap: var(--e-5);
  }

  .ponte__titulo {
    max-inline-size: 18ch;
  }

  .ponte__corpo {
    display: grid;
    gap: var(--e-4);
    justify-items: start;
  }

  .ponte__texto {
    max-inline-size: 44ch;
    font-size: var(--t-destaque);
    line-height: var(--altura-apoio);
  }

  .ponte__link {
    padding-block: max(0px, (var(--alvo-minimo) - 1lh) / 2);
    font-weight: 700;
  }

  @media (min-width: 64rem) {
    .ponte__grade {
      grid-template-columns: 1.1fr 0.9fr;
      column-gap: var(--e-8);
      align-items: center;
    }
  }
</style>
