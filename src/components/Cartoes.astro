---
// Bloco claro de cartões: os formatos de aula, as frentes da empresa, o que a página parcial já diz.
// O item pode ter id próprio quando o menu aponta para ele.
import Texto from './Texto.astro';
import BotaoContato from './BotaoContato.astro';
import type { ServicoId } from '../lib/contato';
import type { TextosPorPublico } from '../lib/publico';

interface Props {
  id: string;
  titulo: string;
  apoio: string;
  itens: { id?: string; titulo: string; texto: string }[];
  nota: string;
  cta?: string;
  textos?: TextosPorPublico;
  servico?: ServicoId;
}

const { id, titulo, apoio, itens, nota, cta, textos, servico } = Astro.props;
---

<section class="cartoes" id={id} aria-labelledby={`${id}-titulo`}>
  <div class="conteiner cartoes__grade">
    <div class="cartoes__cabeca">
      <h2 id={`${id}-titulo`} class="revela"><Texto de={titulo} /></h2>
      <p class="cartoes__apoio"><Texto de={apoio} /></p>
    </div>

    <ul class="cartoes__lista" role="list">
      {
        itens.map((item) => (
          <li class="cartao" id={item.id}>
            <h3 class="cartao__titulo">
              <Texto de={item.titulo} />
            </h3>
            <p class="cartao__texto">
              <Texto de={item.texto} />
            </p>
          </li>
        ))
      }
    </ul>

    <div class="cartoes__fecho">
      <p class="cartoes__nota texto-secundario"><Texto de={nota} /></p>
      {(cta || textos) && <BotaoContato texto={cta} textos={textos} servico={servico} />}
    </div>
  </div>
</section>

<style>
  .cartoes {
    padding-block: var(--secao);
  }

  .cartoes__grade {
    display: grid;
    gap: var(--e-6);
  }

  .cartoes__apoio {
    max-inline-size: 48ch;
    margin-block-start: var(--e-4);
    color: var(--navy-2);
    font-size: var(--t-destaque);
    line-height: 1.45;
  }

  .cartoes__lista {
    display: grid;
    gap: var(--e-4);
    padding: 0;
    list-style: none;
  }

  .cartao {
    display: grid;
    gap: var(--e-3);
    align-content: start;
    padding: var(--e-5);
    border: 1px solid var(--linha);
    background-color: var(--branco);
  }

  .cartao:target {
    border-color: var(--magenta);
  }

  .cartao__titulo {
    font-size: var(--t-destaque);
  }

  .cartao__texto {
    max-inline-size: 42ch;
    color: var(--navy-2);
  }

  .cartoes__fecho {
    display: grid;
    gap: var(--e-5);
    justify-items: start;
  }

  .cartoes__nota {
    max-inline-size: 52ch;
    font-size: var(--t-pequeno);
  }

  /* auto-fit: a seção com quatro frentes ocupa quatro colunas, a com três ocupa três. */
  @media (min-width: 48rem) {
    .cartoes__lista {
      grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
      gap: var(--e-5);
    }
  }

  @media (min-width: 64rem) {
    .cartoes__fecho {
      grid-template-columns: 1fr auto;
      align-items: center;
      gap: var(--e-6);
    }
  }
</style>
