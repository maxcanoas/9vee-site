---
// A trilha de navegação no alto das páginas internas, tirada do endereço, igual ao BreadcrumbList que o Base
// monta. O último passo é a página onde a pessoa está: não é link. Os separadores são meias-luas da marca, sem
// texto para o leitor de tela.
import Texto from './Texto.astro';
import { dadosDoSite } from '../lib/site';
import { trilhaDaPagina } from '../lib/paginas';

const site = await dadosDoSite();
const passos = await trilhaDaPagina(Astro.url.pathname);
const ultimo = passos.length - 1;
---

<nav class="trilha" aria-label={site.trilha.rotulo}>
  <ol class="trilha__lista">
    {
      passos.map((passo, i) => (
        <li class="trilha__passo">
          {i < ultimo ? (
            <a class="trilha__link" href={passo.caminho}>
              <Texto de={passo.nome} />
            </a>
          ) : (
            <span aria-current="page">
              <Texto de={passo.nome} />
            </span>
          )}
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .trilha__lista {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--e-2);
    padding: 0;
    margin: 0;
    list-style: none;
    color: var(--sobre-escuro);
    font-size: var(--t-pequeno);
  }

  .trilha__passo {
    display: inline-flex;
    align-items: center;
    gap: var(--e-2);
  }

  /* A meia-lua entre os passos: forma, e não texto, para o leitor de tela não ler um separador. */
  .trilha__passo + .trilha__passo::before {
    content: '';
    inline-size: 0.3em;
    block-size: 0.6em;
    border-radius: 0 var(--raio-pilula) var(--raio-pilula) 0;
    background-color: currentColor;
  }

  .trilha__link {
    position: relative;
    color: var(--papel);
  }

  /* A área de toque de 44 x 44 px fica num pseudo-elemento, por cima do link, e não em padding: assim a trilha
     não cresce, e o botão do hero continua na primeira tela em 1280 x 800. */
  .trilha__link::after {
    content: '';
    position: absolute;
    inset-block: min(0px, (100% - var(--alvo-minimo)) / 2);
    inset-inline: min(0px, (100% - var(--alvo-minimo)) / 2);
  }
</style>
