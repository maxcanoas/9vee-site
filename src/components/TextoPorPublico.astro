---
// As três versões ficam no HTML; o CSS mostra a do público salvo antes da primeira pintura.
import Texto from './Texto.astro';
import type { TextosPorPublico } from '../lib/publico';

interface Props {
  textos: TextosPorPublico;
}

const { textos } = Astro.props;
---

<span data-publico-texto="neutro"><Texto de={textos.neutro} /></span><span data-publico-texto="empresa"><Texto de={textos.empresa} /></span><span data-publico-texto="voce"><Texto de={textos.voce} /></span>
