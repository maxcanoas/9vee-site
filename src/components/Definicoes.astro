---
// Uma lista de definições, um termo por linha: os exames de proficiência, os pontos da metodologia.
// O id é a âncora da seção, para o menu apontar (#provas).
import CabecaDeSecao from './CabecaDeSecao.astro';
import Texto from './Texto.astro';

interface Props {
  id: string;
  titulo: string;
  apoio: string;
  itens: { nome: string; texto: string }[];
}

const { id, titulo, apoio, itens } = Astro.props;
---

<section class="definicoes" id={id} aria-labelledby={`${id}-titulo`}>
  <div class="conteiner definicoes__grade">
    <CabecaDeSecao {id} {titulo} {apoio} />

    <dl class="definicoes__lista">
      {
        itens.map((item) => (
          <div class="definicao">
            <dt class="definicao__nome">
              <Texto de={item.nome} />
            </dt>
            <dd class="definicao__texto">
              <Texto de={item.texto} />
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .definicoes {
    padding-block: var(--secao);
  }

  .definicoes__grade {
    display: grid;
    gap: var(--e-6);
    align-items: start;
  }

  .definicoes__lista {
    display: grid;
  }

  /* Lado a lado, o item mais curto estica até a altura do vizinho: sem o align-content, a sobra iria para entre
     o nome e o texto. */
  .definicao {
    display: grid;
    gap: var(--e-1);
    align-content: start;
    padding-block: var(--e-4);
    border-block-start: 1px solid var(--linha);
  }

  .definicao__nome {
    font-family: var(--fonte-titulo);
    font-size: var(--t-destaque);
    font-weight: 600;
    line-height: var(--altura-subtitulo);
  }

  .definicao__texto {
    max-inline-size: 44ch;
    margin: 0;
    color: var(--navy-2);
  }

  @media (min-width: 48rem) {
    .definicoes__lista {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--e-6);
    }
  }

  @media (min-width: 64rem) {
    .definicoes__grade {
      grid-template-columns: 0.8fr 1.2fr;
      column-gap: var(--e-8);
    }
  }
</style>
