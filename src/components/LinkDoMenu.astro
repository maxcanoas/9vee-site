---
// Um desenho só para os links do menu: o painel do computador, o menu do celular e a 404 usam este. Os atributos
// passam direto para o <a>, e com eles a marca de escopo de quem chama, para o estilo dele valer aqui.
import type { HTMLAttributes } from 'astro/types';
import Texto from './Texto.astro';

interface Props extends HTMLAttributes<'a'> {
  href: string;
  rotulo: string;
  descricao?: string;
}

const { rotulo, descricao, class: classe, ...atributos } = Astro.props;
---

<a class:list={['link-do-menu', classe]} {...atributos}>
  <span class="link-do-menu__nome"><Texto de={rotulo} /></span>
  {descricao && <span class="link-do-menu__descricao"><Texto de={descricao} /></span>}
</a>

<style>
  .link-do-menu {
    display: grid;
    gap: var(--e-1);
    min-block-size: var(--alvo-minimo);
    text-decoration: none;
  }

  .link-do-menu__nome {
    font-family: var(--fonte-titulo);
    font-size: var(--t-destaque);
    font-weight: 600;
    line-height: var(--altura-subtitulo);
    text-decoration-line: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: var(--sublinhado-destaque);
    text-underline-offset: 0.2em;
    transition-property: text-decoration-color;
    transition-duration: var(--dur-rapida);
  }

  .link-do-menu:hover .link-do-menu__nome,
  .link-do-menu[aria-current='page'] .link-do-menu__nome {
    text-decoration-color: var(--magenta);
  }

  .link-do-menu__descricao {
    color: var(--navy-2);
    font-size: var(--t-pequeno);
  }
</style>
