---
// A imagem em arco com o círculo da marca atrás, aparecendo por cima dos ombros dela: o visual do topo das
// páginas internas. Entra como segunda coluna da grade do topo; no celular, fica centralizado embaixo do texto.
// Com legenda, a foto vira figura e leva embaixo o lugar dela, com um alfinete de mapa: é o caso dos idiomas.
import Figura from './Figura.astro';
import CirculoMarca from './CirculoMarca.astro';
import Texto from './Texto.astro';
import type { Imagem } from '../content.config';

interface Props {
  imagem: Imagem;
  /** O lugar da foto, como "Paris, França", para quem não reconhece a cidade pelo marco. */
  legenda?: string;
}

const { imagem, legenda } = Astro.props;
// A legenda fica dentro do quadro para subir junto com a foto no parallax, sem abrir distância dela.
const Quadro = legenda ? 'figure' : 'div';
---

<div class="arco-com-circulo">
  <div class="arco-com-circulo__circulo" aria-hidden="true">
    <CirculoMarca sizes="(min-width: 64rem) 21rem, (min-width: 32.5rem) 19rem, 58vw" primeiraDobra />
  </div>
  <Quadro class="arco-com-circulo__quadro">
    <Figura
      {...imagem}
      proporcao="4/5"
      forma="arco"
      primeiraDobra
      sizes="(min-width: 64rem) 22rem, min(62vw, 20rem)"
      larguras={[400, 640, 800]}
    />
    {
      legenda && (
        <figcaption class="arco-com-circulo__legenda">
          <svg class="arco-com-circulo__alfinete" viewBox="0 0 16 20" aria-hidden="true" focusable="false">
            <path
              fill-rule="evenodd"
              d="M8 0a8 8 0 0 0-8 8c0 5.6 8 12 8 12s8-6.4 8-12a8 8 0 0 0-8-8Zm0 11a3 3 0 1 1 0-6 3 3 0 0 1 0 6Z"
            />
          </svg>
          <span><Texto de={legenda} /></span>
        </figcaption>
      )
    }
  </Quadro>
</div>

<style>
  .arco-com-circulo {
    position: relative;
    justify-self: center;
    inline-size: min(62vw, 20rem);
  }

  .arco-com-circulo__quadro {
    position: relative;
    z-index: 1;
  }

  /* No tom do apoio, centrada sob o arco. O alfinete leva a cor do grupo, como a meia-lua da saudação. */
  .arco-com-circulo__legenda {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: var(--e-2);
    margin-block-start: var(--e-4);
    color: var(--sobre-escuro);
    font-size: var(--t-rotulo);
    font-weight: 600;
    line-height: var(--altura-rotulo);
    text-align: center;
  }

  .arco-com-circulo__alfinete {
    flex: none;
    inline-size: 0.8em;
    block-size: 1em;
    fill: var(--cor-grupo);
  }

  .arco-com-circulo__circulo {
    position: absolute;
    inset-block-start: -7%;
    inset-inline: 3%;
  }

  @media (min-width: 64rem) {
    .arco-com-circulo {
      justify-self: end;
      inline-size: min(100%, 22rem);
    }
  }

  /* Parallax curto: a imagem sobe um pouco e descola do círculo. O Astro não põe escopo no nome da animação,
     por isso ele leva o nome do componente. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: scroll()) {
      .arco-com-circulo__quadro {
        animation-name: arco-com-circulo-quadro;
        animation-duration: 1ms;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: scroll(root);
        animation-range: 0 70svh;
        will-change: transform;
      }
    }
  }

  @keyframes arco-com-circulo-quadro {
    from {
      transform: translateY(0);
    }
    to {
      transform: translateY(-8%);
    }
  }
</style>
