---
import Texto from './Texto.astro';
import { detalheDaPendencia, lerPendencias, type TextosDePendencia } from '../lib/texto';

interface Item {
  valor: number;
  prefixo?: string;
  rotulo: string;
  pendencia?: string;
}

interface Props {
  titulo: string;
  itens: Item[];
  aviso: string;
  pendencia: TextosDePendencia;
}

const { titulo, itens, aviso, pendencia } = Astro.props;
// Cada nota diz com quem está, como a etiqueta das pendências no meio do texto.
const notas = itens.flatMap((item) =>
  item.pendencia ? lerPendencias(item.pendencia).map((nota) => detalheDaPendencia(nota, pendencia)) : [],
);
---

<section class="prova" aria-labelledby="prova-titulo">
  <div class="conteiner">
    <h2 id="prova-titulo" class="visualmente-oculto">{titulo}</h2>
    {/* Uma coluna por número no computador: a faixa cabe numa linha só, com quatro ou cinco números. */}
    <ul class="prova__lista" role="list" style={`--colunas: ${itens.length}`}>
      {
        itens.map((item) => (
          <li class="prova__item">
            {/* Prefixo e valor colados no código: qualquer quebra de linha entre eles vira espaço na tela. */}
            <span class:list={['prova__numero', item.pendencia && 'prova__numero--pendente']}>{item.prefixo}<span class="prova__valor" data-contador={item.valor} data-digitos={String(item.valor).length}>{item.valor}</span></span>
            <span class="prova__rotulo">
              <Texto de={item.rotulo} />
            </span>
          </li>
        ))
      }
    </ul>
    {
      notas.length > 0 && (
        <details class="prova__notas">
          <summary class="prova__aviso">
            <span class="prova__etiqueta">{pendencia.etiqueta}</span>
            <span>
              <Texto de={aviso} />
            </span>
          </summary>
          <ul class="prova__lista-notas">
            {notas.map((nota) => (
              <li>
                <Texto de={nota} />
              </li>
            ))}
          </ul>
        </details>
      )
    }
  </div>
</section>

<style>
  .prova {
    padding-block: var(--e-6) var(--e-5);
    border-block-end: 1px solid var(--linha);
  }

  /* A lista é a medida dos números no computador (veja a regra no fim). */
  .prova__lista {
    container-type: inline-size;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--e-5) var(--e-4);
    padding: 0;
    list-style: none;
  }

  .prova__item {
    display: grid;
    gap: var(--e-1);
    align-content: start;
  }

  /* No celular, com um número a mais nas duas colunas, o último fica com a linha inteira, e não sozinho na metade. */
  .prova__item:last-child:nth-child(odd) {
    grid-column: 1 / -1;
  }

  .prova__numero {
    justify-self: start;
    font-family: var(--fonte-titulo);
    font-size: var(--t-numero);
    white-space: nowrap;
    font-weight: 600;
    line-height: 1;
    letter-spacing: var(--rastreio-titulo);
  }

  /* Borda e não text-decoration: o sublinhado não atravessa o inline-block do valor. */
  .prova__numero--pendente {
    padding-block-end: var(--e-sublinhado);
    border-block-end: var(--sublinhado-destaque) dashed var(--magenta);
  }

  /* Largura reservada: a Readex Pro não tem números tabulares, e a contagem não pode empurrar o rótulo. */
  .prova__valor {
    display: inline-block;
    text-align: end;
  }

  .prova__valor[data-digitos='2'] {
    min-inline-size: 2ch;
  }

  .prova__valor[data-digitos='3'] {
    min-inline-size: 3ch;
  }

  .prova__rotulo {
    color: var(--navy-2);
  }

  .prova__notas {
    margin-block-start: var(--e-5);
    font-size: var(--t-pequeno);
  }

  .prova__aviso {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--e-2);
    min-block-size: var(--alvo-minimo);
    color: var(--navy-2);
    cursor: pointer;
  }

  .prova__etiqueta {
    padding-block: var(--e-etiqueta-bloco);
    padding-inline: var(--e-etiqueta-linha);
    border: 1px dashed var(--magenta);
    border-radius: var(--raio-pilula);
    background-color: var(--magenta-veu);
    color: var(--navy);
    font-weight: 700;
  }

  .prova__lista-notas {
    display: grid;
    gap: var(--e-2);
    margin-block-start: var(--e-3);
    padding-inline-start: var(--e-5);
    color: var(--navy-2);
  }

  @media (min-width: 48rem) {
    .prova__lista {
      grid-template-columns: repeat(var(--colunas), minmax(0, 1fr));
    }

    /* Com cinco colunas num tablet, o número diminui junto com a faixa, para o "+" não quebrar a linha. Todos ficam
       do mesmo tamanho, porque a medida é a lista, e não a coluna de cada um. */
    .prova__numero {
      font-size: min(var(--t-numero), calc(28cqi / var(--colunas)));
    }

    .prova__item:last-child:nth-child(odd) {
      grid-column: auto;
    }

    .prova__item + .prova__item {
      padding-inline-start: var(--e-5);
      border-inline-start: 1px solid var(--linha);
    }
  }
</style>
