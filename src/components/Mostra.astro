---
// Uma frase em tipo de mostra, a maior da página, com o que a sustenta logo abaixo. É o título da seção.
// Cada linha da frase abre com um trecho no grifo, na cor do grupo de quem contrata (o mapa [data-grupo] do base.css).
// Dentro do grifo e do resto da linha o espaço não quebra: quando a linha não cabe, o resto desce inteiro
// ("7 dias" e, embaixo, "por semana."), e não fica uma palavra sozinha.
import Texto from './Texto.astro';
import { comEspacoFixo } from '../lib/texto';

interface Props {
  id: string;
  /** O id do grupo em content/site.md, que dá a cor do grifo. */
  grupo: string;
  linhas: { grifo: string; texto: string }[];
  apoio: string;
  itens: { titulo: string; texto: string }[];
}

const { id, grupo, linhas, apoio, itens } = Astro.props;
---

<section class="mostra" id={id} aria-labelledby={`${id}-titulo`} data-grupo={grupo}>
  <div class="conteiner mostra__grade">
    <h2 id={`${id}-titulo`} class="mostra__titulo revela">
      {
        linhas.map((linha, i) => (
          <>
            {i > 0 && <br />}
            <span class="grifo">
              <Texto de={comEspacoFixo(linha.grifo)} />
            </span>{' '}
            <Texto de={comEspacoFixo(linha.texto)} />{' '}
          </>
        ))
      }
    </h2>

    <p class="mostra__apoio"><Texto de={apoio} /></p>

    <ul class="mostra__itens" role="list">
      {
        itens.map((item) => (
          <li class="mostra__item">
            <h3 class="mostra__item-titulo">
              <Texto de={item.titulo} />
            </h3>
            <p class="mostra__item-texto">
              <Texto de={item.texto} />
            </p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .mostra {
    padding-block: var(--secao);
    background-color: var(--nevoa);
  }

  .mostra__grade {
    display: grid;
    gap: var(--e-6);
  }

  /* O overflow-wrap só age na tela mais estreita que um trecho inteiro: sem ele, o trecho empurraria a página
     para o lado. */
  .mostra__titulo {
    font-size: var(--t-mostra);
    overflow-wrap: break-word;
  }

  .mostra__apoio {
    max-inline-size: 30ch;
    font-size: var(--t-3);
    line-height: var(--altura-subtitulo);
  }

  .mostra__itens {
    display: grid;
    gap: var(--e-5);
    padding: 0;
    list-style: none;
  }

  .mostra__item {
    padding-block-start: var(--e-4);
    border-block-start: 1px solid var(--navy);
  }

  .mostra__item-titulo {
    font-size: var(--t-destaque);
  }

  .mostra__item-texto {
    max-inline-size: 42ch;
    margin-block-start: var(--e-2);
    color: var(--navy-2);
  }

  @media (min-width: 64rem) {
    .mostra__grade {
      grid-template-columns: 0.9fr 1.1fr;
      gap: var(--e-7) var(--e-8);
      align-items: start;
    }

    .mostra__titulo {
      grid-column: 1 / -1;
    }

    .mostra__itens {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--e-6);
    }
  }
</style>
