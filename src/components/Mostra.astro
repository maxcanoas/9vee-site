---
// Uma frase em tipo de mostra, a maior da página, com o que a sustenta logo abaixo. É o título da seção, e o grifo
// dela sai na cor do grupo (o mapa [data-grupo] do base.css).
// O título curto vem em linhas, cada uma com o grifo no começo. Dentro do grifo e do resto da linha o espaço não
// quebra: quando a linha não cabe, o resto desce inteiro ("7 dias" e, embaixo, "por semana."), e não fica uma palavra
// sozinha. O título de uma frase só leva o grifo no meio dela e quebra onde couber.
import Texto from './Texto.astro';
import { comEspacoFixo } from '../lib/texto';

type Titulo =
  | { linhas: { grifo: string; texto: string }[]; frase?: never }
  | { frase: { antes: string; grifo: string; depois: string }; linhas?: never };

type Props = Titulo & {
  id: string;
  /** O id do grupo em content/site.md, que dá a cor do grifo. */
  grupo: string;
  /** A assinatura que fecha a frase, na escrita de outro idioma, com o lang dele. */
  assinatura?: { texto: string; lang: string };
  apoio: string;
  itens: { titulo: string; texto: string }[];
};

const { id, grupo, linhas, frase, assinatura, apoio, itens } = Astro.props;
---

<section class="mostra" id={id} aria-labelledby={`${id}-titulo`} data-grupo={grupo}>
  <div class="conteiner mostra__grade">
    <div class="mostra__cabeca">
      <h2 id={`${id}-titulo`} class="mostra__titulo revela">
        {
          linhas?.map((linha, i) => (
            <>
              {i > 0 && <br />}
              <span class="grifo">
                <Texto de={comEspacoFixo(linha.grifo)} />
              </span>{' '}
              <Texto de={comEspacoFixo(linha.texto)} />{' '}
            </>
          ))
        }
        {/* O grifo e o que vem depois dele ficam colados no código: uma quebra de linha ali vira espaço na tela, e a
            vírgula se soltaria da palavra. */}
        {
          frase && (
            <>
              <Texto de={frase.antes} />{' '}
              <span class="grifo"><Texto de={frase.grifo} /></span><Texto de={frase.depois} />
            </>
          )
        }
      </h2>
      {
        assinatura && (
          <p class="mostra__assinatura" lang={assinatura.lang}>
            {assinatura.texto}
          </p>
        )
      }
    </div>

    <p class="mostra__apoio"><Texto de={apoio} /></p>

    <ul class="mostra__itens" role="list">
      {
        itens.map((item) => (
          <li class="mostra__item">
            <h3 class="mostra__item-titulo">
              <Texto de={item.titulo} />
            </h3>
            <p class="mostra__item-texto">
              <Texto de={item.texto} />
            </p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .mostra {
    padding-block: var(--secao);
    background-color: var(--nevoa);
  }

  .mostra__grade {
    display: grid;
    gap: var(--e-6);
  }

  .mostra__cabeca {
    display: grid;
    gap: var(--e-5);
  }

  /* O overflow-wrap só age na tela mais estreita que um trecho inteiro: sem ele, o trecho empurraria a página
     para o lado. */
  .mostra__titulo {
    font-size: var(--t-mostra);
    overflow-wrap: break-word;
  }

  /* A assinatura fecha a frase do lado direito, como numa carta. */
  .mostra__assinatura {
    justify-self: end;
    font-family: var(--fonte-titulo);
    font-size: var(--t-2);
    font-weight: 600;
    line-height: var(--altura-subtitulo);
  }

  .mostra__apoio {
    max-inline-size: 30ch;
    font-size: var(--t-3);
    line-height: var(--altura-subtitulo);
  }

  .mostra__itens {
    display: grid;
    gap: var(--e-5);
    padding: 0;
    list-style: none;
  }

  .mostra__item {
    padding-block-start: var(--e-4);
    border-block-start: 1px solid var(--navy);
  }

  .mostra__item-titulo {
    font-size: var(--t-destaque);
  }

  /* Com número ímpar de itens, o primeiro abre a lista, em tipo maior. No computador ele ocupa a linha inteira, e os
     outros ficam em pares, abaixo dele. */
  .mostra__item:first-child:nth-last-child(odd) .mostra__item-titulo {
    font-size: var(--t-3);
  }

  .mostra__item-texto {
    max-inline-size: 42ch;
    margin-block-start: var(--e-2);
    color: var(--navy-2);
  }

  @media (min-width: 64rem) {
    .mostra__grade {
      grid-template-columns: 0.9fr 1.1fr;
      gap: var(--e-7) var(--e-8);
      align-items: start;
    }

    .mostra__cabeca {
      grid-column: 1 / -1;
    }

    .mostra__itens {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--e-6);
    }

    .mostra__item:first-child:nth-last-child(odd) {
      grid-column: 1 / -1;
    }
  }
</style>
