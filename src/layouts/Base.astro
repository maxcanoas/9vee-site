---
import { Font } from 'astro:assets';
import { GA4_ID, MODO } from 'astro:env/server';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/movimento.css';
import '../styles/formulario.css';
import AvisoCookies from '../components/AvisoCookies.astro';
import Cabecalho from '../components/Cabecalho.astro';
import Rodape from '../components/Rodape.astro';
import Drawer from '../components/Drawer.astro';
import BotaoWhatsApp from '../components/BotaoWhatsApp.astro';
import { dadosDoSite, type PaginaId } from '../lib/site';
import { organizacao, serializarJsonLd, trilhaDeNavegacao } from '../lib/jsonld';
import { textoPuro } from '../lib/texto';
import { imagemDaPagina, textoDaImagem } from '../lib/compartilhamento';
import { trilhaDaPagina } from '../lib/paginas';
import { paginaDoContatoDaCidade, paginaDoContatoDoIdioma } from '../lib/contato';
import { CHAVE_PUBLICO, PUBLICOS } from '../lib/publico';
import type { ModeloDeCidade } from '../lib/cidades';

// As páginas de idioma e de cidade saem de um modelo: o nome da página na mensagem e o pedido saem do idioma ou da
// cidade, que só elas dizem.
type Props = {
  titulo: string;
  descricao: string;
  jsonLd?: Record<string, unknown>[];
} & (
  | { pagina: Exclude<PaginaId, 'idioma' | ModeloDeCidade>; idioma?: never; naCidade?: never }
  | { pagina: 'idioma'; idioma: { slug: string; nome: string }; naCidade?: never }
  | { pagina: ModeloDeCidade; naCidade: string; idioma?: never }
);

const { pagina, idioma, naCidade, titulo, descricao, jsonLd = [] } = Astro.props;
const site = await dadosDoSite();
const dadosDaPagina = idioma
  ? paginaDoContatoDoIdioma(site.paginas.idioma, idioma)
  : naCidade
    ? paginaDoContatoDaCidade(site.paginas[pagina], naCidade)
    : site.paginas[pagina];
const base = Astro.site ?? new URL(Astro.url.origin);
const indexavel = MODO === 'producao';
// O preview sai sem GA4, com ou sem ID: a 9vee testa o site sem misturar visitas de teste com as de verdade.
const ga4 = MODO === 'preview' ? '' : GA4_ID;
// A página de erro responde por qualquer endereço que não existe: ela não tem endereço próprio para apontar.
const canonical = pagina === 'erro404' ? null : new URL(Astro.url.pathname, base).href;
const tituloPuro = textoPuro(titulo);
// Cada página tem a própria prévia, com o título dela. A de erro fica com a geral, o logo sobre a arte da marca.
const imagemPrevia = new URL(pagina === 'erro404' ? '/og.jpg' : imagemDaPagina(Astro.url.pathname), base).href;
const textoDaPrevia = pagina === 'erro404' ? site.marca.nome : textoDaImagem(tituloPuro, site.marca.nome);
const descricaoPura = textoPuro(descricao);
// A home é o começo da trilha, e a página de erro não tem lugar no site. As outras têm a trilha na tela, no
// hero, e aqui a mesma trilha para o Google, as duas tiradas do endereço.
const comTrilha = pagina !== 'home' && pagina !== 'erro404';
const dadosEstruturados = serializarJsonLd([
  organizacao(site, base),
  ...(comTrilha ? [trilhaDeNavegacao(base, await trilhaDaPagina(Astro.url.pathname))] : []),
  ...jsonLd,
]);
// A mesma meta tag que o Wix põe hoje em todas as páginas (docs/wix-inventario.md, conferida no ar em 06/10/2026):
// com ela, a propriedade do Search Console continua verificada na troca. Só a produção vai para o Google.
const VERIFICACAO_DO_SEARCH_CONSOLE = 'pn_hIzMzIKPctgmpkHXWDAaBlJQPbNxFKKO6s8ZyvCg';
const regrasDeSpeculation = JSON.stringify({
  prerender: [{ where: { href_matches: '/*' }, eagerness: 'moderate' }],
});
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content"
    />
    <title>{tituloPuro}</title>
    <meta name="description" content={descricaoPura} />
    {!indexavel && <meta name="robots" content="noindex, nofollow" />}
    {indexavel && <meta name="google-site-verification" content={VERIFICACAO_DO_SEARCH_CONSOLE} />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={site.marca.nome} />
    <meta property="og:title" content={tituloPuro} />
    <meta property="og:description" content={descricaoPura} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={imagemPrevia} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={textoDaPrevia} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#f9f9f9" />
    {/* O PNG leva o tamanho, para o Chrome preferir o SVG. O favicon.ico fica na raiz, sem link: quem o pede não
        lê o HTML. */}
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <Font cssVariable="--fonte-titulo" preload={[{ subset: 'latin', weight: '600', style: 'normal' }]} />
    {/* O texto do topo também vem antes da primeira pintura: com a fonte reserva, o apoio quebra numa linha a mais e
        empurra a foto quando a Source Sans chega (CLS do Quem Somos e do inglês no ticket 17). */}
    <Font cssVariable="--fonte-texto" preload={[{ subset: 'latin', weight: '400', style: 'normal' }]} />
    {/* Antes da primeira pintura: marca que há JS e aplica o público salvo, sem piscar.
        A chave e os públicos vêm de src/lib/publico.ts, os mesmos do script da página. */}
    <script is:inline define:vars={{ chave: CHAVE_PUBLICO, publicos: PUBLICOS }}>
      var raiz = document.documentElement;
      raiz.classList.add('js');
      try {
        var publico = localStorage.getItem(chave);
        if (publicos.indexOf(publico) >= 0) raiz.dataset.publico = publico;
      } catch (erro) {}
    </script>
    <script type="speculationrules" is:inline set:html={regrasDeSpeculation} />
    <script type="application/ld+json" is:inline set:html={dadosEstruturados} />
  </head>
  <body>
    <AvisoCookies textos={site.cookies} ga4={ga4} depurar={MODO === 'local'} />
    <Cabecalho site={site} />
    <main id="conteudo" tabindex="-1">
      <slot />
    </main>
    <Rodape site={site} />
    <BotaoWhatsApp site={site} pagina={dadosDaPagina} />
    <Drawer site={site} pagina={dadosDaPagina} />
    <script>
      import '../scripts/publico.ts';
      import '../scripts/cookies.ts';
      import '../scripts/movimento.ts';
      import '../scripts/contato.ts';
    </script>
  </body>
</html>
